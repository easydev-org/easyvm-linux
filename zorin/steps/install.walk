walkthrough "zorin - the ubiquity walk"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user
step "the media this stage boots from is already on disk"
  needs [zorin.iso]


step "create the empty disk"
  disk
    file disk.qcow2
    size 128


step "boot the installer"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=zorin.iso,media=cdrom,readonly=on,if=none,id=media0"], ["-device", "ide-cd,drive=media0,bootindex=0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 1800
step "wait for the live desktop"
  repeat
    do
      item
        read
          name screen
    until
      source screen
      mode like
      reference reference/desktop.png
      range [0.9, 1]
      rect [0, 0, 1920, 120]
      rect_at [1920, 1080]
      must true
    max 1080
    pause 5


step "wake the live session, whose welcome dialog takes a key"
  input ret
  settle 20


step "wake it again"
  input ret
  settle 20


step "wake it again"
  input ret
  settle 20


step "wait for the installer to put itself up"
  repeat
    do
      item
        settle 5
      item
        input ret
      item
        settle 5
      item
        settle 2
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 2
      words [[install, zorin], [try, zorin], [welcome], [false, localization]]
    max 120


step "install zorin os"
  do
    item
      input 1223 586
      settle 3
    item
      input 1223 586
      settle 3
  settle 40


step "install zorin os (once more, if the wizard is not up)"
  do
    item
      input 1223 586
      settle 3
    item
      input 1223 586
      settle 3
  settle 40
  when_not [keyboard]


step "disable the screen saver and the lock"
  run "xrandr --output Virtual-1 --mode 1920x1080 2>/dev/null || xrandr --output Virtual1 --mode 1920x1080 2>/dev/null || xrandr -s 1920x1080 2>/dev/null || true; xset s off; xset -dpms; xset s noblank; gsettings set org.gnome.desktop.session idle-delay 0; gsettings set org.gnome.desktop.screensaver lock-enabled false; ( for i in $(seq 1 1080); do xdotool mousemove_relative -- 1 0 2>/dev/null; xdotool mousemove_relative -- -1 0 2>/dev/null; sleep 20; done ) >/dev/null 2>&1 & exit"
  settle 10
  terminal_wait 8
  type_gap 0.15


step "welcome"
  input 1361 764
  settle 15


step "keyboard - english (us)"
  input 1106 402
  settle 4


step "keyboard"
  input 1361 764
  settle 18


step "updates and other software, when this build shows it"
  input 1361 764
  settle 18
  when_not_any [[installation, type]]


step "the updates pane is done"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [488, 285, 707, 355]
      rect_at [1920, 1080]
      words [[installation, type]]
    max 60


step "the keyboard pane is done"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [488, 285, 707, 355]
      rect_at [1920, 1080]
      words [[installation, type], [updates, and, other, software]]
    max 80


step "installation type - install now"
  input 1361 764
  settle 18


step "the disk warning is up"
  repeat
    do
      item
        settle 2
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [585, 421, 1073, 580]
      rect_at [1920, 1080]
      words [[write, the, changes, to, disks], [partition, tables]]
    max 60


step "the dialog names the filesystem it will create"
  read
    name format


step "the root partition will be ext4"
  check
    source format
    mode text
    name ext4
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    words [ext4]


step "write the changes to disks"
  input 1293 673
  settle 20


step "the disk warning is answered"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [487, 285, 702, 355]
      rect_at [1920, 1080]
      words [[where, are, you], [time, zone]]
    max 60


step "where are you"
  input 1361 764
  settle 18


step "the time zone pane is done"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [487, 285, 803, 416]
      rect_at [1920, 1080]
      words [[who, are, you], [your, name]]
    max 60
# THE FIRST FIELD IS THE FULL NAME AND THE SECOND IS THE USER NAME, AND UBIQUITY JOINS THEM.
#
# MEASURED ON RUN 44941482197's ssh recording, whose terminal TITLE BAR reads
#
#	vmuservmuser@vmuservmuser-Standard-PC-Q35-ICH9...
#
# - user@host - so the ACCOUNT this disk carries is `vmuservmuser`, not `vmuser`, and the hostname
# is that name with `-Standard-PC-Q35-ICH9` appended. Both fields had `{{ user }}` typed into them,
# and ubiquity derives the account from the pair; the doubled name is what that produces.
#
# THE FULL NAME IS NOW A SEPARATE WORD, so the pair is `VM User` / `vmuser` - which is what the
# installer's own greeter and the walkthroughs' `user` expect.


step "who are you - your name"
  settle 2
  input text "VM User"
    at 975 386


step "who are you - username"
  settle 2
  input text "{{ user }}"
    at 859 477


step "who are you - password"
  settle 2
  input text "{{ password }}"
    at 873 514


step "who are you - confirm password"
  settle 3
  input text "{{ password }}"
    at 883 550


step "who are you"
  input 1361 764
  settle 20


step "the install runs, as measured"
  settle 2400


step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
  save "{{ out }}"

walkthrough "nixos - the Calamares walk"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user


step "the media this stage boots from is already on disk"
  needs [nixos.iso]


step "create the empty disk"
  disk
    file disk.qcow2
    size 128


step "boot the installer"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=nixos.iso,media=cdrom,readonly=on,if=none,id=media0"], ["-device", "ide-cd,drive=media0,bootindex=0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 1800
step "wait for the live desktop"
  repeat
    do
      item
        read
          name screen
    until
      source screen
      mode like
      reference reference/desktop.png
      range [0.9, 1]
      rect [1500, 120, 1900, 280]
      rect_at [1920, 1080]
      must true
    max 1080
    pause 5


step "open the installer"
  do
    item
      input 960 640
      settle 3
    item
      input 960 640
      settle 3
  settle 8


step "calamares is up"
  repeat
    do
      item
        input 420 300
        settle 10
      item
        settle 2
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [810, 361, 978, 495]
      rect_at [1920, 1080]
      scale 3
      words [[welcome], [language], [keyboard]]
    max 30


step "the language combo, opened and taken"
  input 1050 736
  settle 3


step "take the current entry"
  input ret
  settle 3


step "next through the pages, until the users page is up"
  repeat
    do
      item
        input 1330 828
        settle 8
      item
        settle 2
      item "read the screen"
        read
          name at_users
    until
      bind here
      source at_users
      mode text
      rect [637, 384, 1146, 526]
      rect_at [1920, 1080]
      scale 3
      words [[name], [Password]]
    max 8


step "the full name field - click the field"
  input 727 375


step "the full name field - select what is there"
  input ctrl+a
  settle 1


step "the full name field - delete the selection"
  input backspace
  settle 1


step "the full name field - type the value"
  input text "{{ user }}"


step "the full name field - the field took it"
  # THE READ WAS 203x27 PIXELS AT SCALE 8, AND TESSERACT ANSWERED `WETTER T | t`.
  #
  # MEASURED on run 45191149160's recording, t=110s: the field DID take the value - `vmuser` is in it
  # and the green tick is beside it - and the step failed anyway, because an 8x enlargement of a
  # 27-pixel-tall strip gives tesseract no baseline to work from. A rect that narrow is not a reading,
  # it is a guess about where the glyphs sit.
  #
  # SO THE WHOLE ROW IS READ, WHICH IS WHAT `scale 3` IS FOR. The row is "What is your name?" plus the
  # field plus its tick, and `vmuser` inside that is what says the field took the value.
  repeat
    do
      item
        settle 2
      item "read the screen"
        read
          name name_field
    until
      bind took
      source name_field
      mode text
      rect [620, 345, 870, 395]
      rect_at [1920, 1080]
      scale 3
      words [["{{ user }}"]]
    max 8
  settle 2

# THE CLICK WAS ON THE WRONG CHECKBOX, ONE ROW TOO LOW.
#
# MEASURED on run 45204798070's recording, t=200s: the page reads
#
#   Choose a password to keep your account safe.
#   [.....]  [.....]  (X) Password is too short
#   [x] Require strong passwords.
#   [x] Use the same password for the administrator account.
#
# - both boxes are five dots, so they DO match, and the error is only "too short". `admin` is five
# characters, and the policy that refuses it is still ON, because the click at 645 537 landed on the
# SECOND checkbox ("Use the same password...") instead of the first. That is why the run then sat on
# `next to the partitions page`: Next is disabled while the password is refused.
#
# THE TWO BOXES ARE 28 PIXELS APART AT 1080p, measured from the same frame: "Require strong passwords"
# is centred on y 512 and "Use the same password for the administrator account" on y 540, both with
# their tick at x 634. The first is the one to clear.
step "users - allow a short password"
  input 634 512
  settle 3


step "the strong-password policy is off"
  repeat
    do
      item
        settle 2
      item "read the screen"
        read
          name policy
    until
      bind off
      source policy
      mode text
      rect [1080, 465, 1350, 500]
      rect_at [1920, 1080]
      scale 2
      words [[Password, is, too, short]]
      must false
    max 6


# THE FOUR POINTS ARE THE CENTRES OF THE FOUR FIELDS, MEASURED FROM THE RECORDING.
#
# MEASURED on run 45191149160's recording, t=110s, magnified 2x: the user's `Password` box occupies
# x 622..822, y 470..489 and `Repeat Password` x 832..1032 at the same y; the administrator's two are
# the same pair at y 587..607. The values below used to be y=495 and y=609, which is the BOTTOM EDGE of
# each box - a click there is a click on the border, and the field keeps its placeholder.
#
# That is why the run reached `next to the partitions page` with `Password is too short` beside both
# pairs: nothing was ever typed into them.
# EACH FIELD IS CLICKED, CLEARED, AND THEN TYPED - AND THE CLEAR IS THE FIX.
#
# MEASURED on run 45202448379, t=200s: both boxes hold something and the installer answers "Your
# passwords do not match!" - the left box shows five dots and the right fifteen. The right one had been
# typed into TWICE, because `input text ... at X Y` clicks and then types WITHOUT clearing.

step "users - password - click it"
  input 722 480
  settle 1


step "users - password - clear what is there"
  input ctrl+a
  settle 1


step "users - password - type the value"
  input text "{{ password }}"
  settle 2


step "users - repeat password - click it"
  input 932 480
  settle 1


step "users - repeat password - clear what is there"
  input ctrl+a
  settle 1


step "users - repeat password - type the value"
  input text "{{ password }}"
  settle 2


step "users - administrator password - click it"
  input 722 597
  settle 1


step "users - administrator password - clear what is there"
  input ctrl+a
  settle 1


step "users - administrator password - type the value"
  input text "{{ password }}"
  settle 2


step "users - administrator repeat password - click it"
  input 932 597
  settle 1


step "users - administrator repeat password - clear what is there"
  input ctrl+a
  settle 1


step "users - administrator repeat password - type the value"
  input text "{{ password }}"
  settle 3


step "next to the partitions page"
  repeat
    do
      item
        input 1330 828
        settle 6
      item
        settle 2
      item "read the screen"
        read
          name at_partitions
    until
      bind here
      source at_partitions
      mode text
      rect [680, 360, 860, 469]
      rect_at [1920, 1080]
      scale 3
      words [[partitioning], [erase]]
    max 8


step "partitions - erase the disk"
  input 633 390
  settle 6


step "partitions -> summary"
  repeat
    do
      item
        input 1330 828
        settle 6
      item
        settle 2
      item "read the screen"
        read
          name at_summary
    until
      bind here
      source at_summary
      mode text
      rect [662, 322, 763, 377]
      rect_at [1920, 1080]
      scale 3
      words [[overview]]
    max 6


step "summary - install"
  repeat
    do
      item
        input 1328 857
        settle 12
      item
        settle 2
      item "read the screen"
        read
          name summary_after
    until
      bind begun
      source summary_after
      mode text
      rect [602, 809, 703, 870]
      rect_at [1920, 1080]
      scale 3
      words [[Installing]]
    max 6



step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
    save "{{ out }}"

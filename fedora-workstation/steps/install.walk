walkthrough "fedora-workstation - anaconda and the first boot"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user


step "the media this stage boots from is already on disk"
  needs [fedora-workstation.iso]


step "create the empty disk"
  disk
    file disk.qcow2
    size 128


step "boot the installer"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=fedora-workstation.iso,media=cdrom,readonly=on,if=none,id=media0"], ["-device", "ide-cd,drive=media0,bootindex=0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 1800
# THE LIVE MEDIUM STOPS AT A LOGIN PROMPT, AND THIS WALK USED TO WAIT FOR A DESKTOP THAT NOBODY HAD
# ASKED FOR.
#
# MEASURED on run 45193503515, whose recording is 4806 frames and whose desktop check answered
# `0.0000 similar` on every one of them. Frame 180 shows
#
#	Nov 23  2:27 PM                                   [Live System User]  <- the selected tile
#	                                                        Not listed?
#	                              fedora
#
# i.e. GDM's user chooser with the live session's account already highlighted. Nothing was wrong with
# the medium, the boot or the check's region: the check was waiting for a wallpaper that this image
# never draws until somebody signs in.
#
# SO THE PROMPT IS ANSWERED FIRST, AND THE ANSWER IS ONE `ret` - the tile is preselected, the live
# account has no password, and pressing Return is what a person does here. The step is gated on the
# prompt's own words, so an image that boots straight to a desktop is not typed into at all.
# THE LOGIN PROMPT IS ANSWERED WHEN IT IS UP, NOT WHEN THE STEP IS REACHED - AND THE FIRST ATTEMPT
# PROVED THE DIFFERENCE.
#
# MEASURED on run 45225696827, whose recording is 4803 frames: at t=300 the screen is STILL
#
#	Nov 23  5:21 PM                          [Live System User]   <- the selected tile
#	                                             Not listed?
#	                          fedora
#
# and at t=4000 it is entirely black - the screen blanked after the idle timeout. So the `ret` this
# step sent never reached the prompt: `when:` gates on the frame the PREVIOUS step captured, and at
# that moment GDM had not drawn yet. The gate was false, the step was skipped, and nothing answered
# the login for eighty minutes.
#
# SO IT LOOPS: wait for the prompt's own words, press Return, then confirm the prompt is GONE. A gate
# that can only look at one frame cannot express "wait for this and then act", which is what this is.
# THE LIVE SESSION MAY ALREADY HAVE LOGGED ITSELF IN, AND THIS LOOP MUST ACCEPT THAT.
#
# MEASURED on run 68ccf6d: the leg failed HERE with
#
#	none of "Live System User" in "Welcome to Fedora Linux This live media can be used ..."
#
# - the welcome dialog was already on screen. Whatever made the prompt appear on earlier runs (an
# autologin timeout, a different GDM configuration between builds) did not happen this time, and the
# loop that waits for the prompt could only ever time out on a guest that had already done what the loop
# was for.
#
# SO "THE WELCOME DIALOG IS UP" IS AN ACCEPTED OUTCOME HERE TOO: it is proof the session started, which
# is the only thing this step wants. The `press Return` step after it is gated on the prompt being
# present, so an already-logged-in guest is not typed into.
# TWO POSSIBLE SCREENS, AND THE REGION HAS TO BE THE ONE THEY SHARE.
#
# MEASURED from run eea9850's recording, frame t=240: GDM's user chooser is drawn with
#
#	[ (user icon)  Live System User ]      at x 785..1130, y 460..510
#	 Not listed?                           at x 790..875,  y 545..560
#
# over a near-black background. Reading the WHOLE FRAME at scale 1 returned the empty string - tesseract
# finds nothing in a 1920x1080 field that is 98% dark - so the loop could never see the prompt it was
# waiting for, and the leg failed at this step with `in ""`.
#
# THE WELCOME DIALOG IS THE OTHER OUTCOME and it is drawn at x 660..1250, y 275..820. A region covering
# the union of both - x 640..1290, y 250..850 - is still small enough for the text to resolve and wide
# enough to hold either screen.
#
# THAT IS THE THIRD TIME THIS STEP HAS BEEN WRONG IN THE SAME WAY: a gate whose region is not the region
# the words are in. The first was the screen saver, the second was the whole frame.
step "the live session is signed in, or asking to be"
  repeat
    do
      item "read the screen"
        read
          name login
    until
      bind asking
      source login
      mode text
      rect [640, 250, 1290, 850]
      rect_at [1920, 1080]
      scale 1
      words [[Live, System, User], [Welcome, to, Fedora]]
    max 90
    pause 5


step "press Return on the selected live user, if the prompt is up"
  input ret
  settle 25
  # AN ALREADY-LOGGED-IN GUEST IS NOT TYPED INTO: a Return on the welcome dialog would press whatever
  # its default button is, and that button launches the installer - which this walk opens deliberately,
  # later, at a coordinate it measured.
  when [Live, System, User]


# THE "PROMPT IS GONE" CONFIRMATION IS DELETED, BECAUSE IT FAILED ON A BLANK SCREEN - AND THE DESKTOP
# CHECK ALREADY CARRIES THE SAME CLAIM.
#
# MEASURED on run 42e065b, which reached step 6 and failed there with
#
#	the prompt is gone ...: see: 0 word(s):
#
# A login that WORKS turns the screen BLACK for a second while GNOME starts the session, and a
# `words: ... must false` check over a region that reads ZERO words is not the same question as "the
# prompt is not there" - it is "I could not read the region", and this engine treats an unreadable
# region as an error rather than as an absence.
#
# NOTHING IS LOST BY DROPPING IT. The step that follows is `wait for the live desktop`, which compares
# the bottom of the frame against reference/desktop.png - a screenshot of THIS live session's own
# desktop. A desktop only exists if the login succeeded, so the desktop check is a strictly stronger
# witness than "the login prompt is absent", and it is one this repository has an actual picture of.

# THE LOGIN SUCCEEDS INTO A WELCOME DIALOG, AND THIS STEP WAITED FOR A BARE DESKTOP THAT IS NEVER SHOWN.
#
# MEASURED from run 830c644's own recording, frame at t=200:
#
#	Welcome to Fedora Linux
#	This live media can be used to install Fedora Linux or as a temporary system.
#	[ Install Fedora Linux... ]   [ Not Now ]
#
# - the live session HAD logged in and put its welcome dialog up. This step compares the bottom band
# [0, 820, 1920, 1020] against reference/desktop.png, and the dialog covers the middle of the screen, so
# the band held the wallpaper only - 0.0014 similar, never 0.9.
#
# AND THE SCREEN THEN BLANKED: frames at t=600 and t=1800 are entirely black. The live session's idle
# timer fires in a few minutes, which is why the later step's `settle 45` and clicks had nothing to act
# on.
#
# SO THIS STEP WAITS FOR THE DIALOG'S OWN WORDS INSTEAD. "Welcome" + "Install" appear on that dialog and
# nowhere else in this live session, and the dialog only exists after a successful login - which is the
# fact this step is actually trying to establish. The dialog is then dismissed by the step that already
# existed for it, which is now reached instead of being blocked forever behind this one.
step "the live session is up, which it announces with its welcome dialog"
  repeat
    do
      item
        read
          name screen
    until
      bind up
      source screen
      mode text
      rect [660, 250, 1250, 900]
      rect_at [1920, 1080]
      scale 1
      words [[Welcome, to, Fedora], [Install, Fedora, Linux]]
    max 240
    pause 5


step "a pointer nudge on the wallpaper, so the idle timer starts again"
  input 960 300
  settle 20


step "answer the live session's welcome dialog"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name welcome_dialog
    until
      bind offered
      source welcome_dialog
      mode text
      rect [773, 536, 1001, 639]
      rect_at [1920, 1080]
      scale 1
      words [[Welcome], [Install]]
    max 30


step "launch the installer"
  input 830 698
  settle 25


step "anaconda's web ui is up"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name anaconda
    until
      bind ready
      source anaconda
      mode text
      rect [538, 72, 725, 143]
      rect_at [1920, 1080]
      scale 1
      words [[Workstation], [Encryption]]
    max 60


# A GNOME SETTINGS WINDOW SITS ON TOP OF THE INSTALLER, AND `esc` DOES NOT CLOSE IT.
#
# MEASURED TWICE. Run 5b490fe's frame at t=800 and run 8c23436's frame at t=900 are the SAME picture,
# and the second run HAD the `esc`-based dismissal this comment replaces:
#
#	+--- Fedora Linux 45 (Workstation Edition) installation -------------- x -+
#	|  1 Welcome  <- the installer's own page, BEHIND                         |
#	|  ( Settings ..........................................  [x] )          |
#	|    Notifications / Search / Keyboard / Mouse & Touchpad / ...          |
#	|    Keyboard:  Input Sources [ English (US) ]  + Add Input Source        |
#	+-------------------------------------------------------------------------+
#
# A GNOME Settings window is a GTK4/libadwaita window and Esc closes its SUB-PAGES, not the window:
# pressing once leaves the Keyboard panel up, which is exactly what both recordings show. The window's
# own close button is at (1425, 254) - the `[x]` in the frame above - and a click there is
# unconditional in a way a key is not.
#
# SO THE CLOSE BUTTON IS CLICKED, THEN THE INSTALLER'S OWN TITLE IS CONFIRMED TO BE THE TOP-MOST TEXT.
# The second half matters because the settings window can come back: something in this live session
# opened it once already, and a dismissal that cannot say "the installer is in front now" is a guess.
# A GUARD, NOT A STEP OF THE INSTALL. The click that used to raise GNOME Settings is gone (see the
# language step above), so on a correct run there is nothing here to close and these two steps do
# nothing. Both are `optional` for exactly that reason: a guard that FAILS when there is nothing to
# guard against turns a working install into a failing leg, which is the shape of mistake this file
# has paid for more than once.
step "close a settings window that should not be there"
  optional true
  input
    click [1425, 254]
  settle 4
  rect [340, 60, 1600, 400]
  rect_at [1920, 1080]
  scale 1
  when_not [installation]


step "the installer is the window in front"
  optional true
  repeat
    do
      item "read the top of the screen"
        read
          name front
    until
      bind frontmost
      source front
      mode text
      rect [340, 60, 1600, 400]
      rect_at [1920, 1080]
      scale 1
      words [[installation]]
      without [Notifications, Mouse, Color, Printers, Accessibility, Wellbeing, Keyboard]
    max 20
    pause 3


step "open the language search"
  input 938 224
  settle 2


step "search for the United States"
  settle 4
  input text "united states"


# THE LANGUAGE IS ALREADY SELECTED, AND CLICKING ITS ROW IS WHAT OPENED GNOME SETTINGS.
#
# MEASURED from run 8c23436's recording:
#
#	t=150   a bare desktop - no installer, no settings window
#	t=250   the installer's Welcome page, `united states` typed, and
#	        `English (United States)  ✓` ALREADY TICKED in the list
#	        `Keyboard  Change system keyboard layout` as a separate link below it
#	t=400   GNOME Settings -> Keyboard, sitting ON TOP of the installer
#	        (Input Sources: English (US), + Add Input Source)
#
# So the click at (853,314) - the middle of the English row - landed on a ROW THAT WAS ALREADY
# SELECTED, and the same click is what raised the keyboard panel: the installer's language row and the
# desktop's own input-source machinery share the same gesture, and the latter opened a window on top of
# the install. Every later step then typed and clicked into Settings instead of anaconda.
#
# THE ROW NEEDS NO CLICK. It carries the tick before anything touches it, because `united states` in
# the search box filters the list to one entry and anaconda selects the single match itself. The step
# is now a READ that asserts the tick is there - which is what the old click was trying to establish
# anyway - and a failing assert is a leg that stops before typing into a settings window.
step "English (United States) is the selected language"
  repeat
    do
      item "read the language list"
        read
          name langlist
    until
      bind chosen
      source langlist
      mode text
      rect [760, 250, 1130, 400]
      rect_at [1920, 1080]
      scale 1
      words [[English, United, States]]
    max 20
    pause 2


step "the wizard is in English now"
  read
    name english


step "it speaks English"
  check
    source english
    mode text
    name ok
    rect [353, 146, 978, 214]
    rect_at [1920, 1080]
    scale 1
    words [[Welcome], [now]]


step "welcome"
  input 726 999
  settle 15


step "the installation method page"
  read
    name method


step "that page asks how to install"
  check
    source method
    mode text
    name asking
    rect [623, 226, 931, 477]
    rect_at [1920, 1080]
    scale 1
    words [[Destination], [Encryption], [storage]]


step "open the storage editor, which is the only place a filesystem can be chosen"
  input 928 446
  settle 8


step "launch it"
  input 794 642
  settle 20


step "the editor is up"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name blivet
    until
      bind up
      source blivet
      mode text
      rect [610, 186, 1431, 344]
      rect_at [1920, 1080]
      scale 1
      words [[Requirements], [Unformatted], [Type]]
    max 60


# THIS FEDORA'S STORAGE PAGE ALREADY HAS A GPT TABLE AND ONE ROW OF FREE SPACE, SO THERE IS NO
# "CREATE PARTITION TABLE" DIALOG TO ANSWER.
#
# MEASURED from run 1f0e1fa's own recording, frame at t=480:
#
#	Storage                                                  Requirements
#	  ID                Type              Location  Size      Fedora Linux requires at least 8.30 GB of disk space.
#	  vda_-_VirtIO Disk GPT partitions            137 GB     Partitions (advanced)
#	  Free space                                  137 GB        /   /boot/efi   (required)
#	                                                [ : ]        /boot           (recommended)
#	[ <- Return to installation ]
#
# The disk is ALREADY GPT and its whole 137 GB is one `Free space` row - the qcow2 the stage creates has
# a partition table, so the "initialize it as GPT" dialog this walk clicked through does not exist. The
# three clicks that were meant to open that dialog landed on the `:` menu of the disk row and on empty
# space instead, which is why the step after them read `Partitior Iyou are cor required:` - fragments of
# the `Partitions (advanced)` panel - and never found Create/Format/Delete.
#
# SO THE WALK OPENS THE FREE-SPACE ROW'S OWN MENU DIRECTLY. Its `:` button is at x≈1183 and the row is
# at y≈361; the disk's row above it has an identical button at y≈322, which is the button the old walk
# pressed by mistake.
step "the free space's menu"
  input 1183 361
  settle 5


step "the free space menu is open"
  repeat
    do
      item
        settle 2
      item "read the screen"
        read
          name the_free_space_menu_is_open
    until
      bind up
      source the_free_space_menu_is_open
      mode text
      # THE MENU OPENS TO THE RIGHT OF THE BUTTON THAT WAS CLICKED, and its items are the ones a
      # blivet-gui row menu carries. The region is wider than the 360x80 box the old interface used,
      # because this build draws a taller menu with a `Help` row under the actions.
      rect [1000, 340, 1500, 640]
      rect_at [1920, 1080]
      scale 1
      words [[Create], [Delete], [Format]]
    max 12


step "create the root partition"
  input 1132 405
  settle 8


step "the root dialog is up"
  repeat
    do
      item
        settle 2
      item "read the screen"
        read
          name the_root_dialog_is_up
    until
      bind up
      source the_root_dialog_is_up
      mode text
      rect [380, 320, 1100, 650]
      rect_at [1920, 1080]
      scale 1
      words [[Create], [Type], [Mount]]
    max 12


step "name it root"
  input text root
    at 882 271
  settle 2


step "mount it at the root"
  input text /
    at 882 333
  settle 2


step "create it, taking the dialog's own ext4 default"
  input 441 628
  settle 8


step "the root partition exists"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name part1
    until
      bind there
      source part1
      mode text
      rect [618, 331, 693, 389]
      rect_at [1920, 1080]
      scale 1
      words [[vda1], [ext4]]
    max 20


step "open the root partition's detail page"
  input 460 363
  settle 6


step "the detail page is up"
  repeat
    do
      item
        settle 2
      item "read the screen"
        read
          name detail
    until
      bind up
      source detail
      mode text
      rect [390, 330, 1040, 410]
      rect_at [1920, 1080]
      scale 1
      words [[UUID], [filesystem]]
    max 12


step "shrink it from the detail page"
  input 1008 267
  settle 6


step "the shrink dialog is up"
  repeat
    do
      item
        settle 2
      item "read the screen"
        read
          name shrink_dialog
    until
      bind up
      source shrink_dialog
      mode text
      rect [400, 200, 950, 350]
      rect_at [1920, 1080]
      scale 1
      words [[Shrink], [Size]]
    max 12


step "shrink it"
  input 1029 562
  settle 6


step "to 136 GB, leaving room for the ESP"
  input 1041 275
  settle 1


step "replace the size"
  input ctrl+a
  settle 1


step "the size the shrink dialog is given"
  settle 2
  input text "136"


step "confirm the shrink"
  input 456 337
  settle 8


step "back to the partition list"
  input 427 222
  settle 6


step "the list is up, with free space on it"
  repeat
    do
      item
        settle 2
      item "read the screen"
        read
          name back_at_list
    until
      bind up
      source back_at_list
      mode text
      rect [618, 277, 694, 354]
      rect_at [1920, 1080]
      scale 1
      words [[Unformatted], [GPT]]
    max 12


step "the new free space's menu"
  # SAME MENU AS STEP 24, SAME PLACE: the small pop-up under the row's three-dot button, at
  # x 1070..1200, y 396..418. This rect was [411,194,519,257] - the top-left of the page.
  # MEASURED on run 44532343964's own recording, whose last frame has that menu open.
  repeat
    do
      item
        input 1185 407
        settle 3
      item
        settle 2
      item "read the screen"
        read
          name fs_menu
    until
      bind open
      source fs_menu
      mode text
      rect [1030, 380, 1350, 460]
      rect_at [1920, 1080]
      scale 1
      words [[Create]]
    max 6


step "create the ESP"
  input 1132 449
  settle 8


step "the ESP dialog is up"
  repeat
    do
      item
        settle 2
      item "read the screen"
        read
          name esp_dialog
    until
      bind up
      source esp_dialog
      mode text
      rect [571, 485, 700, 599]
      rect_at [1920, 1080]
      scale 1
      words [[Overwrite], [Encryption]]
    max 12


step "set the type to the ESP"
  repeat
    do
      item
        input 882 396
        settle 3
      item
        input 648 576
        settle 3
      item
        settle 2
      item "read the screen"
        read
          name type_now
    until
      bind esp
      source type_now
      mode text
      rect [560, 380, 1400, 420]
      rect_at [1920, 1080]
      scale 1
      words [[partition]]
    max 6


step "name it boot - click the field"
  input 882 271


step "name it boot - select what is there"
  input ctrl+a
  settle 1


step "name it boot - delete the selection"
  input backspace
  settle 1


step "name it boot - type the value"
  input text boot
  settle 2

step "create it, and the mount point is filled in for us"
  input 456 566
  settle 10


step "the ESP exists"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name part2
    until
      bind there
      source part2
      mode text
      rect [1343, 466, 1403, 523]
      rect_at [1920, 1080]
      scale 2
      words [[vda2], [EFI]]
    max 20


step "back to the installer"
  input 450 975
  settle 12


step "accept the layout it detected"
  input 756 337
  settle 15


step "the review page, which now names this storage"
  read
    name review


step "the review names a configured layout"
  check
    source review
    mode text
    name configured
    rect [621, 600, 735, 661]
    rect_at [1920, 1080]
    scale 1
    words [[configured], [Review]]


step "next from the installation method"
  repeat
    do
      item
        input 730 999
        settle 12
      item
        settle 2
      item "read the screen"
        read
          name review_page
    until
      bind here
      source review_page
      mode text
      rect [353, 266, 443, 324]
      rect_at [1920, 1080]
      scale 3
      words [[Review]]
    max 4


step "close any quit dialog"
  input esc
  settle 3


step "press install"
  repeat
    do
      item
        input 730 999
        settle 15
      item
        settle 2
      item "read the screen"
        read
          name install_started
    until
      bind begun
      source install_started
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 3
      words [[Installing]]
    max 4



step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
    save "{{ out }}"

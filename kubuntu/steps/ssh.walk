walkthrough "linux-kubuntu - sshd"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user
step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
# THE DESKTOP IS RECOGNISED BY ITS OWN TASKBAR, NOT BY TWO WORDS THAT ARE NOT ON IT.
#
# MEASURED ON RUN 44924791378's ssh leg (kubuntu), whose recording at 60 s is the finished KDE
# desktop with its taskbar, and whose daemon log is this step's own OCR:
#
#	see: 104 word(s): "... Welcome Center ... Welcome to the Ubuntu operating system ..."
#	the session is up ... [check]: up = false (none of "applications" or "kubuntu" in ...)
#
# THE DESKTOP WAS UP. The Welcome Centre covers the middle of it, the panel says "Kubuntu" in a
# wordmark the reader returns as "SEKUDUNTU", and the KDE menu button is an icon with no
# "applications" text at all. A check that names two words this desktop does not print is a check
# that fails on a machine that is working - which is what forty attempts proved.
#
# THE WELCOME CENTRE'S OWN TITLE IS THE HONEST SIGNAL, because that window is what an autologin
# KDE session puts in front of everything else on first boot, and it is what the next step closes.
# EITHER WORD COUNTS: a session where the window was already dismissed shows the panel instead.
# The band is the middle of the screen where the window is drawn, not the whole frame.


# THE GUEST IS AT SDDM, NOT AT A DESKTOP, AND THE OLD CHECK COULD NOT TELL THE DIFFERENCE.
#
# MEASURED on run 45933118254: the frame at 40 s is the SDDM password screen - a clock reading
# 7:19 PM, the vmuser avatar at (960,480), an EMPTY "Password" field at (940,598) - and the stage's
# first step ("the session is up") had already PASSED on it, because that step only looked for the
# words [welcome], [plasma], [kubuntu] in a big rectangle and the login screen carries "kubuntu" in
# its own branding. So no one ever logged in: the alt+f4 that follows closes nothing on SDDM, the
# ctrl+alt+t opens nothing, and the "Welcome Center" seen later was the desktop that finally
# appeared at 250 s - by which time the stage had already typed its commands into the greeter.
#
# SO THE LOGIN IS EXPLICIT, the same four beats cachyos uses and passes with: wait for the avatar's
# own word, click the tile, click the field, type the password, Return. THEN the desktop wait, which
# needs the panel and clock no greeter has - `launcher` is the Kicker menu label on this image's
# panel and is what a grep of a logged-in frame shows and a greeter does not.
# AUTOLOGIN IS ALREADY CONFIGURED ON THIS DISK - THE STAGE STARTS AT A DESKTOP.
#
# MEASURED on run 45934563759: a "greeter" step that waited for the word `vmuser` spent its whole
# budget while the screen read "... the KDE ..." - a logged-in DESKTOP showing the Welcome Center,
# not SDDM. The earlier frames I read as "never logged in" (run 45933118254, 40 s and 260 s) were a
# session that had been LOGGED OUT by three alt+f4 presses: the first closed the Welcome Center, the
# second and third closed the session itself and dropped it back to SDDM, which is why the password
# field filled with dots. Autologin was never broken.
#
# So this waits for the desktop, and the desktop's own marker is `kubuntu` in the panel/wallpaper
# branding - the same word SDDM carries, which is why the shape of this step matters: it waits for
# the Welcome Center's body text ("welcome") that only a logged-in session draws, then closes it
# ONCE.
step "the desktop is up"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name desk0
    until
      bind up
      source desk0
      mode text
      rect [640, 180, 1280, 900]
      rect_at [1920, 1080]
      words [[welcome, center], [plasma]]
    max 60


# ONE alt+f4 CLOSES THE WELCOME CENTER; A SECOND WOULD CLOSE THE SESSION.
#
# MEASURED on run 45933118254: three alt+f4 presses took the guest from the Welcome Center to a
# logged-out SDDM screen (the frame at 260 s is the greeter with the password field filling with
# dots). cachyos presses twice and passes because its Welcome Center is the only window; here the
# first press closes it and the second lands on the desktop with nothing to close - which on this
# image logs the session out. ONE press, then the check below decides.
step "close the welcome center, once"
  settle_before 10
  input alt+f4
  settle 5


# THE WINDOW MUST BE GONE BEFORE THE TERMINAL IS OPENED, OR IT TAKES THE KEYBOARD BACK.
#
# This is the check the earlier attempts lacked: five runs typed their commands into a Welcome Center
# that the stage believed it had closed. `community` is a word from that window's own BODY ("...the
# KDE community!"), so it is present while the window is up and absent once it is gone - and the
# earlier [skip, next] guard passed while the screen still read "Pie community!" because the reader
# had the body text and not the buttons.
step "the welcome center is gone, so the terminal will get the keyboard"
  repeat
    do
      item
        input esc
        settle 2
      item "read the screen"
        read
          name gone
    until
      bind up
      source gone
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      without [community]
    max 15


step "open the terminal"
  input ctrl+alt+t
  settle 20
# NO `terminal_wait:` HERE, AND THAT IS THE FIX RATHER THAN AN OMISSION.
#
# `terminal_wait:` OPENS A TERMINAL (ctrl+alt+t) AND THEN TYPES. The step above has already
# opened one, so a second ctrl+alt+t starts a NEW terminal window and the keys that follow go to
# it - while the command already typed into the first one is never submitted.
#
# MEASURED ON RUN 44545555943's kubuntu ssh recording, whose terminal shows exactly that:
#
#	vmuser@kubuntu:~$ xset s off; xset -dpms; xset s noblank; echo SCREEN_KEPT_ONECHO ADMIN | sudo ...
#	server does not have extension for -dpms option
#	[sudo: authenticate] Password:
#
# `SCREEN_KEPT_ON` runs straight into `ECHO ADMIN` with no line break: the Return after the first
# command went to the OTHER window. And the `xset -dpms` failure - "server does not have extension
# for -dpms option" - is harmless; the screen is still kept awake by `s off` and `s noblank`.
# UBUNTU'S SHAPE - unlock sudo ONCE, then plain sudo - AND THE REASON IS THE SAME HERE.
#
# RUN 44556278874 spent its ten minutes on 'connection refused'. The password travelled inside
# each command line (`echo <password> | sudo -S ...`), so any command whose Return was lost took
# the password with it, and sudo answered 'no password was provided' while apt-get asked for one.


step "unlock sudo once for this session"
  run "printf '%s\\n' {{ password }} | sudo -S -v"
  settle 4
  terminal_wait 0


# A `run:` IS ONLY A COMMAND IF SOMETHING READS BACK THAT IT RAN.
#
# MEASURED on run 45916721322: this step and the two below it typed into a Welcome Center that held
# the focus, and the only thing the stage reported an hour later was `wait for sshd: sshd does not
# accept a connection`. A `run:` returns nothing; the SCREEN is the witness.
#
# SO EACH COMMAND ENDS WITH A SENTINEL WORD AND THE NEXT STEP WAITS FOR THAT WORD. If the keystrokes
# went to a window that is not the terminal, the word never appears, the wait fails HERE, and the
# message names the step that did nothing instead of the port that closed ten minutes later.
# `OPENSSH_INSTALLED` is printed by the same shell line that ran apt, so it cannot be stale.
step "install openssh-server"
  run "sudo apt-get install -y openssh-server; echo OPENSSH_INSTALLED=$?"
  settle 20
  terminal_wait 0


step "prove the install actually ran, by the word it printed"
  repeat
    do
      item
        settle 3
      item "read the terminal"
        read
          name tty
    until
      bind up
      source tty
      mode text
      rect [0, 300, 1920, 1080]
      rect_at [1920, 1080]
      words [[OPENSSH_INSTALLED]]
    max 60


step "allow password authentication"
  run "sudo sed -i \"s/^#\\?\\s*PasswordAuthentication.*/PasswordAuthentication yes/\" /etc/ssh/sshd_config ; sudo grep -i \"^PasswordAuthentication\" /etc/ssh/sshd_config"
  settle 3
  terminal_wait 0


# SAME WITNESS AS THE INSTALL ABOVE: the command proves it ran by printing a word, and the next step
# waits for that word on the screen. `systemctl enable --now ssh` typed into anything but a terminal
# does nothing and says nothing; the sentinel is what turns that into a failure at THIS step.
step "enable ssh at boot"
  run "sudo systemctl enable --now ssh; sudo systemctl disable --now ufw 2>/dev/null; sudo ufw disable 2>/dev/null; sudo systemctl disable --now firewalld 2>/dev/null; sudo systemctl stop firewalld 2>/dev/null; sudo iptables -P INPUT ACCEPT 2>/dev/null; sudo nft flush ruleset 2>/dev/null; sudo sysctl -w net.ipv4.conf.all.rp_filter=2 >/dev/null 2>&1; sudo sysctl -w net.ipv4.conf.default.rp_filter=2 >/dev/null 2>&1; for i in /proc/sys/net/ipv4/conf/*/rp_filter; do echo 2 | sudo tee "$i" >/dev/null 2>&1; done; echo SSH_ENABLED; systemctl is-active ssh"
  settle 8
  terminal_wait 0


# THE ENABLE IS PROVEN BY `wait for sshd` BELOW, NOT BY A WORD ON A SCROLLING SCREEN.
#
# MEASURED on run 45935512565: this sentinel waited its whole budget. The enable line ends with a
# `for i in /proc/sys/net/ipv4/conf/*/rp_filter; do echo 2 | sudo tee ...` loop and `ufw disable`,
# which write a dozen lines; `SSH_ENABLED` scrolls off the visible terminal before the 3-second read
# lands. That is a problem with the INSTRUMENT, not with the command - the same command already ran
# on every earlier attempt, and `wait for sshd` is a probe of the guest, not a reading of its screen.
#
# So this step is removed entirely and the enable's effect is judged by `machine_ssh`.

step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"
  timeout 120


step "prove the account over ssh"
  ssh "id -un; hostname"
  timeout 120


step "ask the guest to power off"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' poweroff"
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
  save "{{ out }}"

walkthrough "linux-kubuntu - sshd"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user
step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
# THE DESKTOP IS RECOGNISED BY ITS OWN TASKBAR, NOT BY TWO WORDS THAT ARE NOT ON IT.
#
# MEASURED ON RUN 44924791378's ssh leg (kubuntu), whose recording at 60 s is the finished KDE
# desktop with its taskbar, and whose daemon log is this step's own OCR:
#
#	see: 104 word(s): "... Welcome Center ... Welcome to the Ubuntu operating system ..."
#	the session is up ... [check]: up = false (none of "applications" or "kubuntu" in ...)
#
# THE DESKTOP WAS UP. The Welcome Centre covers the middle of it, the panel says "Kubuntu" in a
# wordmark the reader returns as "SEKUDUNTU", and the KDE menu button is an icon with no
# "applications" text at all. A check that names two words this desktop does not print is a check
# that fails on a machine that is working - which is what forty attempts proved.
#
# THE WELCOME CENTRE'S OWN TITLE IS THE HONEST SIGNAL, because that window is what an autologin
# KDE session puts in front of everything else on first boot, and it is what the next step closes.
# EITHER WORD COUNTS: a session where the window was already dismissed shows the panel instead.
# The band is the middle of the screen where the window is drawn, not the whole frame.


step "the session is up, which is what autologin is for"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name desk
    until
      bind up
      source desk
      mode text
      rect [600, 200, 1300, 900]
      rect_at [1920, 1080]
      words [[welcome], [plasma], [kubuntu]]
    max 40
# THE WELCOME CENTRE IS UP ON THIS DESKTOP AND IT EATS ctrl+alt+t.
#
# MEASURED ON RUN 44548179034, whose ssh recording at 90 s is "Welcome Center" with its Skip
# button and NOTHING ELSE - no terminal, no shell prompt. Every command of the stage then went
# into a window that was not there, and `wait for sshd` spent its ten minutes on a guest where
# openssh had never been installed.
#
# The same run's NEXT frames show the terminal never appearing, and the daemon log has no output
# under any of the `run:` steps - which is what a stage typing into the desktop looks like.
#
# SO THE WINDOW IS DISMISSED FIRST. `Skip` is at 684,813 on that frame, and the step is optional
# because a desktop that has already been dismissed (or never showed it) must not fail here.
# THE CLICK ON `Skip` WAS MEASURED NOT TO TAKE, SO THE WINDOW IS CLOSED WITH THE KEYBOARD.
#
# RUN 44557862904's recording is the Welcome Centre for its whole length, sitting OVER the
# terminal that ctrl+alt+t had already opened (the shell prompt `vmuser@kubuntu:` is visible in
# the strip of terminal at the left). A click at Skip's own coordinates - 684,813, read off that
# frame - left it there, and every `run:` after it went to the window holding focus.
#
# Alt+F4 closes the focused window whatever its title bar is doing, and a second Escape covers
# the case where the window was already closed and something else took focus.
# THE WELCOME CENTRE IS CLOSED BY ITS OWN BUTTON, IN A LOOP THAT CHECKS IT WENT AWAY.
#
# `press alt+F4` FAILED THE STEP OUTRIGHT - the recording is fourteen frames long - so the chord
# is not usable here (there is no window manager guarantee that a focused window exists at the
# moment the key arrives).
#
# A click on `Skip` was measured not to take ONCE, on a frame where the button had not finished
# drawing. Repeating it until the window's own words are gone is the version that cannot be
# defeated by one badly timed click: the loop reads the pane, and only stops when it no longer
# says 'Welcome'.


step "close the welcome centre, which takes the keyboard"
  # SKIP IS AT (688, 816), AND (700, 838) MISSED IT BY 22 VERTICAL PIXELS.
  #
  # MEASURED on run 45916721322's recording, which is the whole point: frames at 240 s and 320 s are
  # IDENTICAL - "Welcome Center" still open, the clock moving 4:33 -> 4:35 - while the walk typed
  # `apt-get install openssh-server` and `systemctl enable --now ssh` into it. Cropping the frame at
  # (640,780) size 260x80 and scaling it 3x puts Skip's box at x 648..728, y 802..830, so its centre
  # is (688, 816). The old click at (700, 838) is INSIDE the x range but 8 px BELOW the box, on the
  # page body - which is why three clicks changed nothing, openssh was never installed, and
  # `wait for sshd` spent its whole budget on `connection refused` (the guest even RSTs, so this is
  # not the password bug: sshd simply is not there).
  #
  # THREE CLICKS, THEN ESCAPE: a click on Skip was measured not to take once, on a frame where the
  # button had not finished drawing, and a desktop that never showed the window must not fail here.
  # The old value in the paragraph above, (700,838), is kept as a warning: it is 22 px BELOW Skip on
  # the frame this was re-measured from, and it is exactly the kind of near miss that reads as a
  # working click until you watch two minutes of recording that never changes.
  do
    item
      input 688 816
      settle 3
    item
      input 688 816
      settle 3
    item
      input 688 816
      settle 3


step "clear anything the welcome centre left behind"
  input esc
  settle 2


step "open the terminal"
  input ctrl+alt+t
  settle 20
# NO `terminal_wait:` HERE, AND THAT IS THE FIX RATHER THAN AN OMISSION.
#
# `terminal_wait:` OPENS A TERMINAL (ctrl+alt+t) AND THEN TYPES. The step above has already
# opened one, so a second ctrl+alt+t starts a NEW terminal window and the keys that follow go to
# it - while the command already typed into the first one is never submitted.
#
# MEASURED ON RUN 44545555943's kubuntu ssh recording, whose terminal shows exactly that:
#
#	vmuser@kubuntu:~$ xset s off; xset -dpms; xset s noblank; echo SCREEN_KEPT_ONECHO ADMIN | sudo ...
#	server does not have extension for -dpms option
#	[sudo: authenticate] Password:
#
# `SCREEN_KEPT_ON` runs straight into `ECHO ADMIN` with no line break: the Return after the first
# command went to the OTHER window. And the `xset -dpms` failure - "server does not have extension
# for -dpms option" - is harmless; the screen is still kept awake by `s off` and `s noblank`.
# UBUNTU'S SHAPE - unlock sudo ONCE, then plain sudo - AND THE REASON IS THE SAME HERE.
#
# RUN 44556278874 spent its ten minutes on 'connection refused'. The password travelled inside
# each command line (`echo <password> | sudo -S ...`), so any command whose Return was lost took
# the password with it, and sudo answered 'no password was provided' while apt-get asked for one.


step "unlock sudo once for this session"
  run "printf '%s\\n' {{ password }} | sudo -S -v"
  settle 4
  terminal_wait 0


# INSTALLED THROUGH THE GUEST AGENT, BECAUSE A `run:` HERE COULD NOT BE TRUSTED TO RUN AT ALL.
#
# MEASURED on run 45916721322: frames at 240 s and 320 s are IDENTICAL - Welcome Center open, clock
# moving 4:33 -> 4:35 - while `apt-get install openssh-server` was typed. It has a password prompt and
# a progress bar and needs no terminal window to be useful, so it goes to the guest kernel's own
# command channel, where it returns apt's exit status and the installed version. `DEBIAN_FRONTEND` and
# `-o Dpkg::Options` keep it from stopping on a prompt that nobody is there to answer.
# THE AGENT MUST ANSWER BEFORE `qga: exec` IS ASKED ANYTHING.
#
# MEASURED on run 45922889731: the install step failed with "the agent ... does not answer
# `guest-ping`: read ... i/o timeout. The socket is open on the host side, so this is the GUEST's
# agent: it is not installed, or not running, or it is busy". The socket exists as soon as qemu
# starts it; the guest's qemu-guest-agent starts later. `machine_qga` is the fact for that, and
# waiting on it is what keeps this step's verdict about apt rather than about the channel.
step "wait for the guest agent to answer"
  repeat
    until machine_qga
    max 60
    pause 5


step "install openssh-server through the guest agent"
  qga "exec"
  argv ["/bin/sh", "-c", "DEBIAN_FRONTEND=noninteractive apt-get install -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold openssh-server 2>&1 | tail -5; echo ---; dpkg-query -W -f='${Status} ${Version}\n' openssh-server 2>&1"]
  timeout 600
  settle 3


step "allow password authentication"
  run "sudo sed -i \"s/^#\\?\\s*PasswordAuthentication.*/PasswordAuthentication yes/\" /etc/ssh/sshd_config ; sudo grep -i \"^PasswordAuthentication\" /etc/ssh/sshd_config"
  settle 3
  terminal_wait 0


# THE SAME LESSON AS THE INSTALL ABOVE, AND THE PROOF IS THE SAME FRAME.
#
# `systemctl enable --now ssh` is four words and one listener. Typed into a window that is not a
# terminal it does nothing, and the only symptom is a host probe saying "no route to host" ten
# minutes later against a guest whose sshd was never started - which is exactly what this stage did.
# Through the guest agent the enable, the firewall teardown and the listener check return their own
# exit status, and `ss -lnt` is read back rather than assumed.
step "enable ssh and take the firewall down, through the guest agent"
  qga "exec"
  argv ["/bin/sh", "-c", "systemctl enable --now ssh 2>&1 | tail -2; systemctl disable --now ufw >/dev/null 2>&1; ufw disable >/dev/null 2>&1; systemctl disable --now firewalld >/dev/null 2>&1; iptables -P INPUT ACCEPT 2>/dev/null; nft flush ruleset 2>/dev/null; sysctl -w net.ipv4.conf.all.rp_filter=2 >/dev/null 2>&1; sysctl -w net.ipv4.conf.default.rp_filter=2 >/dev/null 2>&1; systemctl is-enabled ssh; ss -lnt 2>/dev/null | grep ':22 ' || echo NO_LISTENER"]
  timeout 180
  settle 3


step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"
  timeout 120


step "prove the account over ssh"
  ssh "id -un; hostname"
  timeout 120


step "ask the guest to power off"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' poweroff"
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
  save "{{ out }}"

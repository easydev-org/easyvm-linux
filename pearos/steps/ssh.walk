walkthrough "pearos - the first-boot wizard, the desktop, and sshd answering"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user


# pearOS HAS NO `Remote Login` PANEL, AND THIS STAGE IS WHERE THAT MATTERS.
#
# macOS answers this with System Settings -> General -> Sharing -> Remote Login, a switch that enables
# sshd and opens the door in one gesture. pearOS has nothing of the sort: it is Arch with KDE, so ssh
# is openssh and `sshd.service`, and a fresh install ships the package but leaves the unit DISABLED
# and the account without any key. There is no button to find, so the walk has to do what a person
# with a terminal would do.
#
# THE ACCOUNT IS CREATED BY THE INSTALLER, NOT BY THE INSTALL WIZARD.
#
# The Calamares sequence in `pear-calamares-config` has no `users` page - which is why `install.walk`
# fills no user form - but its last shellprocess runs
#
#	arch-chroot ${ROOT} useradd -m -g users -G wheel,autologin -s /bin/bash default
#	arch-chroot ${ROOT} bash -c "echo 'default:pearos' | chpasswd"
#	printf 'default ALL=(ALL) NOPASSWD:ALL' >> ${ROOT}/etc/sudoers
#
# so the installed disk signs itself in as `default` with the password `pearos`, and that account has
# passwordless sudo. That is what makes the ssh stage possible at all: there is a session to run a
# command from without anyone typing at a greeter.
#
# THE FIRST BOOT RUNS A WIZARD THAT THE DISK CANNOT SKIP.
#
# `/usr/local/bin/bin_post`, installed into /etc/skel/.config/autostart, starts an Electron app at
# login: a `hello` page, then language, keymap, timezone, the account form, a light/dark choice, an
# agreement, and `finish`. `finish` runs `post_setup`, which creates the account the user typed,
# installs a one-shot unit that deletes `default` before SDDM starts, and closes the window.
#
# SO `default` EXISTS ONLY UNTIL THE WIZARD IS ANSWERED. This walk answers it, which is not a
# formality: on a disk left at the `hello` page, `default` is the only account and its passwordless
# sudo is the only way in.
#
# WHAT THIS STAGE PROVES, in order, and each is a different claim:
#
#	1. the disk boots to the wizard (the smoke stage already records this much)
#	2. the wizard can be driven to the end, which is the only path to a desktop
#	3. `post_setup` completes and the desktop appears
#	4. sshd can be enabled from that desktop
#	5. sshd actually answers for the account just created
#
# STEP 5 IS THE ONE THE PIPELINE NEEDS. Everything after this stage reaches the guest over ssh, and
# an enabled unit that no account can authenticate against is the same as no sshd at all.

step "boot the installed disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900


# THE WIZARD OPENS ON `hello`, WHICH IS ONE BUTTON UNDER A LARGE HAND-DRAWN WORD - AND THAT BUTTON IS
# NOT A RELIABLE OCR TARGET.
#
# MEASURED across three runs: the pill is x 940..1045, y 870..930, white on a saturated blue field, and
# the reader returned nothing for it at `scale 1`, `scale 2`, and for both a tight crop and a wide one.
# The word is drawn as thin dark glyphs on a 90-pixel-tall rounded pill, which is the hardest thing on
# this screen to read and the only thing that matters.
#
# SO THIS STEP DOES NOT READ: IT PRESSES. The page has exactly one action, the click is idempotent
# while the page is up (a second press on the next page is a click on empty background), and the next
# step's own heading check is what proves the press worked. That is a stronger proof than a word on a
# button, because it is the wizard's real state rather than a picture of its label.
#
# THE CLICKS ARE SPACED AND REPEATED because the stroke animation takes four seconds: the button is in
# the DOM from the first frame, and the press is safe even while the word is still being drawn.
# ONCE, NOT TWICE. MEASURED: pressing it twice ended on this same `hello` page again - the second press
# landed on the language page's back-arrow corner and walked the wizard backwards. One press and a long
# settle is what the hand run did.
# THE WIZARD HAS TO BE ON SCREEN BEFORE THE PRESS, AND IN CI IT IS NOT.
#
# MEASURED on run 45637758644: `clicked (990, 900)` is logged IMMEDIATELY after `qemu started`, with not
# one frame in between. The press landed while the guest was still booting, so the page never changed -
# the log's language check then spent its whole budget reading `hello`'s strokes, and the recording's
# last frames are black because the session blanked with nothing ever typed into it.
#
# THE HAND RUN NEVER SAW THIS because a person waits: the desktop is up and the wizard drawn before the
# button is pressed. So the wait is made explicit here, and it is measured on the guest's own clock
# rather than guessed - the same session was at `hello` by 60 seconds of recording.
#
# IT WAITS ON THE PICTURE, NOT THE CLOCK ALONE: `hello` is a large bright stroke on a saturated blue
# field, and its word is drawn as a path so an OCR read of it is worthless (measured - the reader
# returns tokens like `lO` and `4`). The brightness of the button's own pill is the stable signal, so
# the wait asks for a frame with a bright region where the pill sits.
step "wait for the wizard's first page to be drawn"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name drawn
    until
      bind there
      source drawn
      # MEASURED ON A REAL FRAME (run 45637758644's recording at 60s): this inner box is the pill's own
      # white fill and averages 229; the saturated blue field around it averages 102. The wider box
      # that includes the pill's edge averages 127 and cannot tell the two apart, which is why the box
      # is the fill and not the button.
      mode mean_between
      rect [960, 885, 1020, 915]
      rect_at [1920, 1080]
      range [180, 255]
    max 90
    pause 5


# THE PRESS IS A BARE PAIR - `input <x> <y>` - which is the form every other walk in this repository
# uses for a click (`input 1777 933` in pearos' own install.walk). `input click [...]` is READ AS A KEY
# NAME by the parser and refused, so the pair is the only spelling that reaches the pointer.
#
# TWENTY SECONDS OF SETTLE, NOT SIX: the stroke draws for four seconds and the page's own transition is
# half a second, and a press landing during either is a press on a page that is about to be replaced.
# The hand run waited twenty and the language page was always there when it came back.
step "hello - press continue"
  input 990 900
  settle 20


# THE WIZARD'S OWN SCREENS, EACH A HEADING AND A `Continue`. The headings are the checks because they
# are the largest text on every page and appear nowhere else in this installer.
step "the language page"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name lang
    until
      bind there
      source lang
      mode text
      rect [740, 455, 1160, 500]
      rect_at [1920, 1080]
      scale 2
      words [[Select, Your, Language]]
    max 60
    pause 3

# THE LIST MUST BE CLICKED, NOT ASSUMED. MEASURED: pressing Continue with nothing selected raises
# `You must select one language from the list` and stays on the page - the first row is not preselected
# even though the widget draws a highlight on it. `English (United States)` is the sixth row.
#
# AND `Continue` IS NOT AT THE BOTTOM OF THE SCREEN: the wizard is a centred card and its button sits at
# the card's lower-right corner, (1300, 817). A click at the screen's bottom edge misses it entirely.
step "language - choose English (United States)"
  input 960 618
  settle 3

step "language - continue"
  input 1300 817
  settle 8


step "the keyboard page"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name kmap
    until
      bind there
      source kmap
      mode text
      rect [740, 455, 1180, 500]
      rect_at [1920, 1080]
      scale 2
      words [[Select, Your, Keyboard, Layout]]
    max 60
    pause 3

step "keyboard - choose US"
  input 960 518
  settle 3

step "keyboard - continue"
  input 1300 817
  settle 8


step "the time zone page"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name tz
    until
      bind there
      source tz
      mode text
      rect [740, 455, 1160, 500]
      rect_at [1920, 1080]
      scale 2
      words [[Select, Your, Time, Zone]]
    max 60
    pause 3

step "time zone - choose UTC"
  input 960 576
  settle 3

step "time zone - continue"
  input 1300 817
  settle 8


# THE ACCOUNT FORM, WHICH IS THE PAGE THAT MAKES `default` UNNECESSARY.
#
# Five fields, top to bottom: full name, account name, hostname (pre-filled with `pearOS-machine`),
# password, verify password. `full_name` is written to /tmp/fullname with quotes around it and passed
# to `useradd -c`, so it may contain spaces; the account name is checked by the page's own regex,
# `^[a-z][a-z0-9-]*$`, which is why the walk uses `{{ user }}` and not something with a dot in it.
step "the account page"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name acct
    until
      bind there
      source acct
      mode text
      rect [400, 200, 1500, 400]
      rect_at [1920, 1080]
      scale 2
      words [[Create, a, Computer, Account]]
    max 60
    pause 3

# ONE `input` PER STEP, AND `at` IS THE FIELD'S CENTRE: the verb clicks there, selects all and deletes
# before typing, so a field that already holds text (the hostname's `pearOS-machine`) arrives empty
# rather than appended to.
# THE FIVE FIELDS AND THEIR MEASURED CENTRES. The hostname arrives pre-filled with `pearOS-machine`
# and is left alone; the password pair is what `post_setup` hands to `chpasswd`, so these two must
# match or the wizard's own `Passwords match` tick never appears and Continue stays grey with a red
# no-entry badge.
step "account - full name"
  input text "VM User"
    at 930 571
  settle 3

# `clear: true` FOR THE SAME REASON AS ANDUINOS': a field that arrives pre-filled makes `click at`
# append rather than replace, and the account created is then not the one every later `ssh:` dials.
# MEASURED on AnduinOS, whose username box held a `vm` and produced `vmvmuser`; this page's box is
# empty here, and the flag costs nothing when it is.
step "account - account name"
  input text "{{ user }}"
    at 930 606
    clear true
  settle 3

step "account - password"
  input text "{{ password }}"
    at 886 725
  settle 3

step "account - verify password"
  input text "{{ password }}"
    at 1120 725
  settle 4

step "account - continue"
  input 1300 817
  settle 6


step "the appearance page"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name look
    until
      bind there
      source look
      mode text
      rect [400, 200, 1500, 400]
      rect_at [1920, 1080]
      scale 2
      words [[Choose, Your, Look]]
    max 60
    pause 3

step "appearance - continue, light is selected"
  input 1300 817
  settle 6


step "the agreement page"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name agree
    until
      bind there
      source agree
      mode text
      rect [400, 200, 1500, 400]
      rect_at [1920, 1080]
      scale 2
      words [[Terms, and, Conditions]]
    max 60
    pause 3

step "agreement - continue"
  input 1300 817
  settle 6


# `FINISH` IS NOT A BUTTON: THE PAGE RUNS `post_setup` ITSELF and quits its own window when the script
# reports success. So what this waits for is the script, and the script ends on a GREETER, not a desktop.
#
# MEASURED by driving the whole wizard by hand: `post_setup` installs two packages, creates the account,
# schedules the removal of `default`, sets keymap/timezone/sudoers, and the window disappears - leaving
# SDDM with the new account's avatar and the caption `Touch ID or Enter Password`. pearOS does NOT
# autologin the account the wizard made, even though the medium's `users.conf` says `doAutologin: true`:
# that module never runs, because the Calamares sequence replaces the `users` page with these
# shellprocess steps.
#
# SO THE GREETER IS THE WITNESS THAT THE SCRIPT FINISHED, and the next step answers it.
step "post_setup runs and the session ends on a greeter"
  settle 300


step "the greeter is up"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name greet
    until
      bind there
      source greet
      mode text
      rect [700, 940, 1250, 1010]
      rect_at [1920, 1080]
      scale 2
      words [[Touch, ID, or, Enter, Password], [Enter, Password]]
    max 180
    pause 5


# THE GREETER IS ANSWERED THE WAY THAT ALREADY WORKED ONCE, PLUS A CLEAR.
#
# TWO ATTEMPTS FAILED HERE AND EACH TAUGHT SOMETHING:
#
#	run 45641931139  clicked (960,880) then typed at (960,942) -> `Login failed`
#	run 45650926213  same, with longer settles                     -> `Login failed`
#	local run        same                                          -> logged in, 39/39
#
# The click is the avatar, which is what opens SDDM's password field - so the field exists. What differs
# between the local pass and the failing runs is what was ALREADY IN the box: SDDM remembers a failed
# entry, and a `input text` that appends makes `admin1admin1` or `admin1` after a stale prefix.
#
# `clear: true` NOW ACTUALLY CLEARS (it was declared in the vocabulary and never implemented - fixed in
# easyvm 17d2724), so the field is emptied before the password is typed, whatever the greeter left there.
#
# THE AVATAR IS CLICKED RATHER THAN `ret` PRESSED because that is the path the local run proved; the
# keyboard path was tried in the last two CI runs and both ended on `Login failed` as well.
step "leave the greeter for a console"
  input ctrl+alt+f3
  settle 12


step "the console asks for a login"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name tty
    until
      bind there
      source tty
      mode text
      rect [0, 0, 900, 1080]
      rect_at [1920, 1080]
      scale 2
      words [[login]]
    max 40
    pause 4


# A KEY PRESS FIRST, BECAUSE A VIRTUAL CONSOLE THAT HAS JUST BEEN SWITCHED TO TAKES NO TEXT.
#
# MEASURED on run 45676355385: `typed 6 character(s)` for the account and again for the password, and
# the recording stays on `pearOS-machine login: _` for the whole budget - the keys reached the emulated
# keyboard and the VT never consumed them. The local run of the same file logged in, so the difference
# is timing: `ctrl+alt+f3` returns before the console's keyboard is attached to the emulated device.
#
# `ret` IS THE SAFE WAKE KEY: on a `login:` prompt an empty Return redraws the prompt (a username of
# nothing is refused locally by agetty, which asks again) and it costs no character in the field. `spc`
# would have been a username character and `login:  vmuser` is not the account.
step "wake the console's keyboard"
  input ret
  settle 4

step "the account name"
  input text "{{ user }}"
  settle 3

step "submit the name"
  input ret
  settle 4

step "the password on the console"
  input text "{{ password }}"
  settle 3

step "submit the password"
  input ret
  settle 15


# THE PROMPT AFTER A SUCCESSFUL LOGIN CARRIES THE ACCOUNT AND THE HOST, which is proof the kernel
# accepted the password - the thing SDDM would not do.
# THE PROMPT IS READ AS TWO FIXED WORDS, NOT AS THE ACCOUNT NAME.
#
# MEASURED on the local run: the reader returns `[umuser@pear0S-machine` for the prompt - it draws `v`
# as `[`, `O` as `0` and `S` as `5` in this bitmap console font - so a check for `vmuser` can never pass
# on a screen where the login DID succeed. The greeting above the prompt and the `@` in the prompt are
# what the reader gets right, and both appear only after the password is accepted:
#
#	Welcome to pearOS NiceC0re!
#	[vmuser@pearOS-machine ~]$
step "the console is a shell for the wizard's account"
  repeat
    do
      item
        settle 4
      item "read the screen"
        read
          name sh
    until
      bind there
      source sh
      mode text
      rect [0, 40, 700, 160]
      rect_at [1920, 1080]
      scale 2
      words [[Welcome, to, pearOS]]
    max 40
    pause 4


# SSH IS TURNED ON FROM THE CONSOLE THAT JUST LOGGED IN, WHICH IS THE WHOLE REASON FOR IT.
#
# pearOS ships openssh and leaves `sshd.service` disabled - there is no `Remote Login` panel, and macOS'
# switch has no equivalent here. `systemctl enable --now sshd` is the operation, and it needs root: the
# console session is the wizard's account, which `post_setup` put in `wheel` and gave a sudoers line.
#
# THE PASSWORD IS PIPED IN because `sudo -S` reads it from stdin and a `run:` has none - measured on
# AnduinOS' stage, where the same mistake left both commands waiting for a password that never came.
step "start sshd now and at every boot"
  run "printf '%s\n' {{ password }} | sudo -S systemctl enable --now sshd"
  settle 20
  terminal_wait 0


step "the unit says it is running"
  run "systemctl is-active sshd"
  settle 6
  terminal_wait 0


step "sshd answers"
  repeat
    until machine_ssh
    max 90
    pause 10


step "the build, over ssh"
  ssh "grep PRETTY_NAME /etc/os-release"


step "the account, over ssh"
  ssh "id -un"


step "the file system, over ssh"
  ssh "findmnt -no FSTYPE /"


# THE WIZARD'S OWN TRACE, WHICH IS WHAT MAKES THE ACCOUNT REAL RATHER THAN A LEFTOVER: `default` is
# scheduled for deletion by the same script that created this one, so a machine that still answers as
# `default` never finished `post_setup`.
step "the account the wizard made is the one that answers"
  ssh "test \"$(id -un)\" = '{{ user }}'"


step "stop the machine"
  stop kill
  timeout 120

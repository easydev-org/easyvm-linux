walkthrough "linux-pearos - configure the vm (name, share, guest agent, autologin)"
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var boot_timeout
  default "1800"
  from args.boot_timeout
var host
  default 172.30.0.1
  from args.host
var hostname
  default easyvm-vm
  from args.hostname
var out
  default out/vm-configure.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user
ssh_port 2222


# THE SAME FOUR THINGS EVERY LINUX STAGE HERE DOES, PLUS THE ONE THIS DISTRIBUTION NEEDS AND NO OTHER
# IN THIS REPOSITORY DOES.
#
#	1. a name, in hostnamectl and in /etc/hosts' 127.0.1.1 line
#	2. the guest agent, so the machine can be shut down without a power cut
#	3. the share, proved reachable, and the launcher installed for the next login
#	4. AUTOMATIC LOGIN, WHICH pearOS DOES NOT DO
#
# THE FOURTH IS MEASURED, NOT ASSUMED. The ssh stage's recording ends on SDDM's greeter with the
# wizard's avatar and `Touch ID or Enter Password`, so a published pearOS disk waits for a password at
# every boot. An unattended client cannot type one - and the launcher this stage installs is a
# `~/.config/systemd/user` unit, which only starts inside a session. Without autologin the disk boots
# to a greeter and the bootstrap never runs.
#
# pearOS' `users.conf` says `doAutologin: true`, and that is why this was missed for two runs: the
# Calamares sequence REPLACES the `users` page with shellprocess steps, so that module never executes.
# The setting has to be written here, into SDDM's own conf.d.


step "take the input disk"
  disk disk.qcow2


step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout "{{ boot_timeout }}"


step "wait for sshd"
  repeat
    until machine_ssh
    max 90
    pause 10


step "announce the machine's name"
  ssh "echo \"this machine will be named '{{ hostname }}'\""
  timeout 60


step "set the machine's name"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' hostnamectl set-hostname {{ hostname }}\n"
  timeout 120


step "point the loopback line at that name"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' sh -c '\n  if grep -q \"^127\\.0\\.1\\.1\" /etc/hosts; then\n    sed -i \"s/^127\\.0\\.1\\.1.*/127.0.1.1\\t{{ hostname }}/\" /etc/hosts\n  else\n    printf \"127.0.1.1\\t%s\\n\" \"{{ hostname }}\" >> /etc/hosts\n  fi'\n"
  timeout 120


step "prove the name"
  ssh "set -e\necho \"static: $(hostnamectl --static)\"\necho \"kernel: $(hostname)\"\necho \"hosts:  $(grep -c '{{ hostname }}' /etc/hosts) line(s)\"\ntest \"$(hostnamectl --static)\" = \"{{ hostname }}\"\ntest \"$(hostname)\" = \"{{ hostname }}\"\ngrep -q '{{ hostname }}' /etc/hosts\n"
  timeout 60


# THE GUEST AGENT. Arch, so pacman - and the index is refreshed first because a published disk's
# database is as old as the day it was installed.
step "refresh the package index"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' pacman -Sy 2>&1 | tail -3\n"
  timeout 600


step "install the guest agent"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' pacman -S --noconfirm qemu-guest-agent 2>&1 | tail -5\n"
  timeout 600


step "enable the guest agent"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' systemctl enable --now qemu-guest-agent 2>&1 | tail -3\n"
  timeout 120


step "prove the guest agent is running"
  ssh "systemctl is-active qemu-guest-agent &&\nls -l /dev/virtio-ports/org.qemu.guest_agent.0 2>&1 &&\nsystemctl show -p MainPID --value qemu-guest-agent\n"
  timeout 120


# AUTOMATIC LOGIN, IN SDDM'S OWN DROP-IN DIRECTORY.
#
# `[Autologin]` with `User=` and `Session=` is the whole of it on Arch: SDDM reads every file in
# `/etc/sddm.conf.d/`, and the session name is `plasma` for this desktop. `Relogin=true` makes a
# session that exits - which is what a broken desktop is - come back rather than leave a black screen.
#
# THE FILE IS WRITTEN RATHER THAN EDITED because a drop-in is the supported way and an edit to
# `sddm.conf` itself is overwritten by the next package upgrade.
step "turn on automatic login, because an unattended client cannot type a password"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' sh -c '\n  mkdir -p /etc/sddm.conf.d\n  cat > /etc/sddm.conf.d/10-easyvm-autologin.conf <<CONF\n[Autologin]\nUser=%s\nSession=plasma\nRelogin=true\nCONF\n  printf \"autologin for %s\\n\" \"{{ user }}\"' 2>&1 | tail -3\n"
  timeout 120


step "prove automatic login is configured"
  ssh "set -e\ncat /etc/sddm.conf.d/10-easyvm-autologin.conf\ngrep -q '^User={{ user }}$' /etc/sddm.conf.d/10-easyvm-autologin.conf\ngrep -q '^Session=plasma$' /etc/sddm.conf.d/10-easyvm-autologin.conf\necho AUTOLOGIN_OK\n"
  timeout 60


# THE SCREEN IS KEPT AWAKE, BECAUSE A BLANKED SCREEN IS A MACHINE THAT LOOKS DEAD. pearOS runs KDE on
# Wayland and does not install `xset` - MEASURED: `zsh: no such file or directory: /usr/bin/xset` - so
# the KDE power settings are written instead, for this user, in the file KDE reads at session start.
# `kscreenlockerrc` WITH `Autolock=false` IS THE LOCK, AND THE LOCK IS WHAT A BLANKED SCREEN IS.
# KDE turns the display off on its own idle timer and then locks; with no lock the session stays
# usable, and a screenshot of the desktop keeps showing a desktop rather than a black frame - which
# is what every pearOS ssh run had to fight.
step "stop the screen from locking"
  ssh "set -e\nmkdir -p ~/.config\nprintf '[Daemon]\\nAutolock=false\\nLockOnResume=false\\n' > ~/.config/kscreenlockerrc\ncat ~/.config/kscreenlockerrc\n"
  timeout 60


step "prove the screen will not lock"
  ssh "grep -q '^Autolock=false$' ~/.config/kscreenlockerrc && echo SCREEN_WILL_NOT_LOCK"
  timeout 60


step "prove the guest can fetch from the host share"
  ssh "sh -c 'curl -fsS --max-time 20 http://172.30.0.1:8080/shared/ || wget -qO- --timeout=20 http://172.30.0.1:8080/shared/'"
  timeout 180


step "show what the guest sees at the share"
  ssh "sh -c 'curl -fsS --max-time 20 http://172.30.0.1:8080/shared/ 2>&1 | head -20; echo \"fetch exit = $?\"'"
  timeout 120


# THE LAUNCHER IS A systemd USER UNIT, WHICH NEEDS THE USER MANAGER - hence the autologin above: the
# unit is enabled here and starts at the next login, which on this disk is the every-boot autologin.
step "copy the launcher in"
  copy
    template launcher
    to /tmp/bootstrap-launcher.sh
  timeout 300


step "install the launcher"
  ssh "set -e\ninstall -m 0755 /tmp/bootstrap-launcher.sh ~/bootstrap-launcher.sh\nmkdir -p ~/.config/systemd/user\ncat > ~/.config/systemd/user/org.vm.bootstrap.service <<'UNIT'\n[Unit]\nDescription=Run ~/shared/bootstrap.sh at login\n\n[Service]\nType=oneshot\nExecStart=%h/bootstrap-launcher.sh\n\n[Install]\nWantedBy=default.target\nUNIT\nsystemctl --user daemon-reload || true\nsystemctl --user enable org.vm.bootstrap.service\necho INSTALLED_FOR_NEXT_LOGIN\n"
  timeout 300


step "prove the launcher is installed"
  ssh "set -e\nls -l ~/bootstrap-launcher.sh ~/.config/systemd/user/org.vm.bootstrap.service\ngrep -q bootstrap-launcher.sh ~/.config/systemd/user/org.vm.bootstrap.service\nsystemctl --user is-enabled org.vm.bootstrap.service\ntest \"$(systemctl --user is-enabled org.vm.bootstrap.service)\" = \"enabled\"\n"
  timeout 60


step "ask the guest to power off"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' poweroff"
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
    save "{{ out }}"

walkthrough "manjaro - the Calamares walk"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user


step "the media this stage boots from is already on disk"
  needs [manjaro.iso]


step "create the empty disk"
  disk
    file disk.qcow2
    size 128


step "boot the installer"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=manjaro.iso,media=cdrom,readonly=on,if=none,id=media0"], ["-device", "ide-cd,drive=media0,bootindex=0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 1800
step "wait for the live desktop"
  repeat
    do
      item
        read
          name screen
    until
      source screen
      mode like
      reference reference/desktop.png
      range [0.9, 1]
      rect [0, 0, 1920, 120]
      rect_at [1920, 1080]
      must true
    max 1080
    pause 5


step "let the desktop settle"
  settle 15


step "open the installer"
  input 960 760
    input 960 760
      double [960, 760]
  settle 35


step "open the installer - what is on screen"
  read
    name open_the_installer


step "open the installer - the screen says so"
  check
    source open_the_installer
    mode text
    name asserted
    rect [438, 296, 963, 385]
    rect_at [1920, 1080]
    words [[welcome], [location]]


step "open the installer (once more, if it did not)"
  input 960 760
    input 960 760
      double [960, 760]
  settle 40
  when_not [welcome]


step "welcome"
  input 1325 801
  settle 18


step "location"
  input 1325 801
  settle 18


step "keyboard"
  input 1325 801
  settle 18


step "partitions - erase the disk"
  input 653 340
  settle 6


step "open the filesystem list"
  input 955 396
  settle 5


step "choose ext4"
  input 933 459
  settle 6


step "the partitions page after choosing ext4"
  read
    name fs


step "the root partition is ext4"
  check
    source fs
    mode text
    name ext4
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    words [ext4]


step "partitions"
  input 1325 801
  settle 20


# THE FIRST FIELD IS THE FULL NAME AND THE SECOND IS THE LOGIN NAME, AND THIS INSTALLER JOINS THEM.
#
# MEASURED, and it is the same fault zorin's file records: both fields carried `{{ user }}`, and the
# disk came out with the account `vmuservmuser` - the terminal title bar reads
# `vmuservmuser@vmuservmuser-Standard-PC-Q35-ICH9`, user@host, so the account is the doubled string.
# Every later stage then dialed `vmuser`, which is not an account, and sshd answered
# `unable to authenticate ... no supported methods remain`.
#
# THE FULL NAME IS A SEPARATE WORD, so the pair is `VM User` / `vmuser` - which is what this
# repository's `user vmuser` header and every ssh, vm-configure and dev stage expect.
step "users - full name"
  input text "VM User"
    at 741 320
  clear true
  settle 2


# `clear: true` HERE TOO, AND THIS IS THE FIELD THE DOUBLED NAME CAME FROM. Calamares fills the login
# name from the full name as it is typed - `VM User` becomes `vmuser` on its own - so a plain append
# produces `vmuservmuser`, which is what this disk carried for three stages. Clearing first makes the
# value this walk wrote the value the installer keeps.
step "users - login name"
  input text "{{ user }}"
    at 741 385
    clear true
  settle 2


step "users - password"
  input text "{{ password }}"
    at 724 523
    clear true
  settle 2


step "users - confirm password"
  input text "{{ password }}"
    at 944 523
    clear true
  settle 2


step "users - root password"
  input text "{{ password }}"
    at 741 650
    clear true
  settle 2


step "users - confirm root password"
  input text "{{ password }}"
    at 944 650
    clear true
  settle 3


step "users"
  input 1325 801
  settle 20


step "office suite - no office suite"
  input 700 288
  settle 6


step "office suite"
  input 1334 794
  settle 20


step "summary - install"
  input 1318 799
  settle 18


step "the install confirmation's install now"
  input 1055 537
  settle 30


step "the installer finishes"
  repeat
    do
      item
        input 420 300
        settle 20
      item
        settle 2
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[all, done], [you, may, now], [has, been, installed], [todo, listo], [ya, puede], [reiniciar], [instalación, completada], [instalacion, completada]]
    max 180


step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
    save "{{ out }}"

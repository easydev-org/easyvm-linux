walkthrough "linux-manjaro - sshd"
resolution 1920x1080
recording_resolution 1920x1080
# THE ACCOUNT IS `vmuser`, AND THAT TOOK FIXING THE INSTALL RATHER THAN THIS STAGE.
#
# MEASURED ON RUN 44599025471: Calamares fills the login name from the full name as it is typed, so
# both fields carried `{{ user }}`, the second `type:` APPENDED to the field instead of replacing it,
# and the disk was built with the account `vmuservmuser`. This stage then logged in as `vmuser`,
# which did not exist, and sshd answered `unable to authenticate ... no supported methods remain`.
#
# THE EARLIER ANSWER WAS TO LOG IN AS THE DOUBLED NAME - `user: vmuservmuser` here and in
# vm-configure - which made three stages agree on a wrong account. The install now types `VM User`
# into the full-name field and `{{ user }}` into the login name, so the account is `vmuser` again and
# this file says so.
#
# `ssh_user` IS THE HEADER KEY THE SSH CLIENT READS - `var user` IS NOT.
#
# MEASURED ON RUN 44611943331 (manjaro), whose failure was NOT a refused port but
#
#	wait for sshd: the port is open but no shell answers: ssh: handshake failed: ssh: unable to
#	authenticate, attempted methods [none password], no supported methods remain
#
# - the daemon reached the guest and offered the WRONG NAME. `repeat until machine_ssh` and every `ssh ==`
# step authenticate as `File.SSHUser`, which is parsed from a top-level `ssh_user:` key
# (internal/walk/walk.go) and defaults to `vmuser`. Setting `var user` changes what gets TYPED on
# the console; it does not change who the client logs in as.
user vmuser
var out
  default out/distro.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user



step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
step "the disk's boot menu, when it has one"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name grubmenu
    until
      bind at_menu
      source grubmenu
      mode text
      rect [300, 300, 1640, 480]
      rect_at [1920, 1080]
      scale 1
      words [[manjaro], [advanced, options], [uefi, firmware, settings]]
    max 12
  optional


step "boot the highlighted entry, which is the installed system"
  input ret
  settle 25

  # THE GREETER IS ASKED FOR BEFORE IT IS CLICKED, AND THE WAIT WAKES THE SCREEN.
  #
  # MEASURED ON RUN 44557318104, whose ssh recording at 150 s is SDDM's login screen with the
  # password field still showing its 'Password' PLACEHOLDER - the click and the five characters had
  # not reached it - and the stage then spent ten minutes on 'connection refused'.
  #
  # The Escape is inside the loop for the reason the same wait needed it on endeavour and mint:
  # SDDM blanks to a clock-only screen, and a wait cannot succeed until something wakes it.

step "the greeter is drawn"
  repeat
    do
      item
        input esc
        settle 3
      item
        settle 2
      item "read the screen"
        read
          name greeter
    until
      bind up
      source greeter
      mode text
      # TWO MEASURED FAULTS, BOTH ABOUT THE READER, NOT THE SCREEN.
      #
      # run 45938665592: with `scale 2` this step's whole budget reported `"ee"`.
      # run 45940028937: with `rect [0,0,1920,1080]` and no scale it reported
      #   "Image too small to scale!! (1x36 vs min width of ...)" - the full-frame rect produced a
      #   1x36 strip to read, so the rect and the scaler were fighting each other.
      #
      # The frame at 120 s of the first run is an ordinary SDDM screen: "VM User" over the avatar at
      # (960,460), the Password field at (940,629), Sleep / Restart / Shut Down / Other along the
      # bottom. A rect that encloses exactly those three bands, no scaling, is what the passing
      # kubuntu greeter step uses - so this is that rect.
      rect [700, 380, 1250, 880]
      rect_at [1920, 1080]
      words [[vm, user], [password], [shut, down]]
    max 60

  # THE GREETER IS LOGGED IN WHERE IT STANDS, BECAUSE THE VIRTUAL CONSOLE DOES NOT SWITCH HERE.
  #
  # MEASURED ON RUN 44585841497: 'ctrl+alt+f2' left the screen ON SDDM - the console-tail read
  # 'Virtual Keyboard', which is SDDM's own on-screen keyboard footer, not a getty. So the chord is
  # not reaching a virtual console on this guest.
  #
  # The greeter this file already waited for IS a usable login: 'vmuser', an empty password field
  # at 936,628, and an arrow button beside it. Click the field, type, Return - which is what every
  # other KDE stage here does.

step "greeter - the password box"
  input 936 628
  settle 3


step "greeter - log in"
  settle 3
  input text "{{ password }}"

  # THE PASSWORD IS IN THE FIELD AND RETURN MUST BE PRESSED MORE THAN ONCE.
  #
  # MEASURED ON RUN 44594136209, whose ssh recording at 120 s is SDDM with FIVE DOTS IN THE PASSWORD
  # FIELD - the characters arrived - and no session. One Return a second after the last character
  # is not enough for SDDM to accept it.

step "greeter - submit"
  input ret
  settle 8


step "greeter - submit again, because SDDM can miss the first"
  input ret
  settle 20


step "the desktop is up after the login"
  repeat
    do
      item
        read
          name screen
    until
      source screen
      mode like
      reference reference/desktop.png
      range [0.9, 1]
      rect [0, 0, 1920, 120]
      rect_at [1920, 1080]
      must true
    max 120
    pause 5


step "open the terminal"
  input ctrl+alt+t
  settle 20

  # NO PROBE COMMAND. MEASURED ON endeavour AND mx: a lone 'echo XXX' right after the chord loses
  # its Return, the next command is appended to it, and every character arrives in capitals. The
  # first thing typed after the chord is the command that matters.

step "unlock sudo once for this session"
  run "printf '%s\\n' {{ password }} | sudo -S -v"
  settle 4
  terminal_wait 0


step "install openssh"
  # `pacman -Sy openssh` TRIES TO UPGRADE openssl AND BREAKS pacman ITSELF.
  #
  # MEASURED on run 45941450719's recording at 500 s, on the terminal:
  #
  #	$ sudo pacman -Sy --noconfirm --needed openssh
  #	:: installing openssl (4.1.0-1) breaks dependency 'libcrypto.so=3-64' required by ostree
  #	:: installing openssl (4.1.0-1) breaks dependency 'libcrypto.so=3-64' required by pacman
  #	:: installing openssl (4.1.0-1) breaks dependency 'libcrypto.so=3-64' required by sudo
  #
  # So NOTHING was installed - no sshd, hence "sshd does not accept a connection". This is the classic
  # partial-upgrade trap: `-Sy` refreshes the index and then resolves against the newest packages, and
  # this disk's openssl is older than what the mirror carries. `--ignore openssl*` installs openssh
  # against the packages the disk already has.
  run "sudo -n pacman -S --noconfirm --needed --ignore openssl --ignore openssl-libs openssh 2>&1 | tail -5"
  settle 60
  terminal_wait 0


step "allow password authentication"
  run "sudo -n sh -c 'mkdir -p /etc/ssh/sshd_config.d; printf \"PasswordAuthentication yes\\n\" > /etc/ssh/sshd_config.d/99-vm.conf; sed -i \"s/^#\\?\\s*PasswordAuthentication.*/PasswordAuthentication yes/\" /etc/ssh/sshd_config; grep -q \"^PasswordAuthentication yes\" /etc/ssh/sshd_config || printf \"PasswordAuthentication yes\\n\" >> /etc/ssh/sshd_config' 2>&1 | tail -3"
  settle 3
  terminal_wait 0


  # EVERY `sudo` IN A PIPE NEEDS ITS OWN PASSWORD - `echo pw | sudo -S a; sudo b` GIVES b NONE.
  #
  # MEASURED on run 45945432461's recording at 400 s, on the terminal:
  #
  #	$ echo admin1 | sudo -S -p '' mkdir -p /etc/ssh; echo admin1 | sudo -S -p '' ssh-keygen -A ... ; test -s /etc/ssh/ssh_host_ed25519_key && echo HOST_KEYS_OK || echo HOST_KEYS_MISSING
  #	HOST_KEYS_MISSING
  #	$ echo admin1 | sudo -S systemctl start sshd.socket ... ; sudo sysctl ... ; for i in ...; do echo 2 | sudo tee ...
  #	$ echo admin1 | sudo -S systemctl restart sshd
  #	$ systemctl is-active sshd          <- empty: sshd is not active
  #
  # `sudo -S` reads the password from stdin ONCE per invocation, and `sudo` also CACHES a timestamp -
  # but the FIRST `sudo -S -v` that would seed that cache is in a step whose keystrokes went to a
  # window this stage had lost. So `mkdir` was authenticated and `ssh-keygen` (a SECOND sudo in the
  # same line, with no pipe feeding it) was not: no host keys, no sshd, "no route to host".
  #
  # The fix is `sudo -S -v` FIRST, on its own line, which seeds the timestamp for every sudo that
  # follows in the same terminal - then the rest needs no password at all.
step "unlock sudo for the whole stage, once"
  # THE PASSWORD GOES IN THROUGH THE PIPE, NOT THE KEYBOARD.
  #
  # MEASURED on run 45949016408's recording at 500 s, on the terminal:
  #
  #	[sudo] password for vmuser:
  #	sudo: PAM authentication error: Authentication token manipulation error
  #	sudo: a password is required
  #	[sudo] password for vmuser:
  #	Sorry, try again.
  #
  # A bare `sudo -v` waits for TTY input, and what the walk TYPES into it arrives with
  # `type_gap 0.09`-style pacing that sudo's own read can cut short - and the first attempt also
  # raises the "lecture" block, which delays the read further. `echo pw | sudo -S -v` hands the
  # password over as a complete line from stdin, which is what every other Linux stage here does.
  run "printf '%s\\n' {{ password }} | sudo -S -v 2>&1 | tail -2; sudo -n true && echo SUDO_UNLOCKED || echo SUDO_LOCKED"
  settle 5


step "make the host keys, in a run: - ssh: cannot run before sshd exists"
  # sshd REFUSES TO START WITHOUT HOST KEYS, AND THIS FILE NEVER MADE ANY IN A `run:`.
  #
  # MEASURED: everything the stage could report was "no route to host", and the probe line is
  # `dial tcp 172.30.0.1:2222: connect: no route to host` - the guest has no listener. manjaro's
  # `ssh-keygen -A` is inside an `ssh:` step (line ~257), which runs OVER ssh - so it can only work
  # once sshd is already up, which is exactly what it is supposed to cause. cachyos, which passes,
  # does the keygen in a `run:` before anything waits. This is that step.
  run "sudo -n sh -c 'mkdir -p /etc/ssh; ssh-keygen -A; test -s /etc/ssh/ssh_host_ed25519_key && echo HOST_KEYS_OK || echo HOST_KEYS_MISSING' 2>&1 | tail -6"
  settle 10


step "enable sshd at boot"
  run "sudo -n sh -c 'systemctl start sshd.socket 2>/dev/null; systemctl enable sshd; ufw disable 2>/dev/null; systemctl disable --now firewalld 2>/dev/null; sysctl -w net.ipv4.conf.all.rp_filter=2 >/dev/null 2>&1; sysctl -w net.ipv4.conf.default.rp_filter=2 >/dev/null 2>&1; systemctl is-active sshd; ss -lnt | grep :22 || echo NO_LISTENER; echo FIREWALL_OFF' 2>&1 | tail -8"$i" >/dev/null 2>&1; done; echo FIREWALL_OFF"
  settle 8
  terminal_wait 0


step "start sshd"
  run "sudo -n systemctl restart sshd 2>&1 | tail -3"
  settle 10
  terminal_wait 0


step "prove sshd is active"
  run "systemctl is-active sshd"
  settle 5
  terminal_wait 0

  # sshd IS ACTIVE AND PORT 22 STILL ANSWERS WITH A RESET - AND THIS MEDIUM HAS NO FIREWALL AT ALL.
  #
  # MEASURED ON RUN 44594136209's successor, whose terminal reads, in full:
  #
  #	$ sudo systemctl is-active sshd
  #	active
  #	$ sudo firewall-cmd --permanent --add-service=ssh; ...
  #	firewall-cmd: command not found
  #	firewall-cmd: command not found
  #	firewall-cmd: command not found
  #
  # So the earlier guess - "firewalld refuses the port" - is wrong: firewalld is not even installed
  # here. `active` plus a REFUSED connection means sshd is listening somewhere that is not 22, or
  # not listening on the forwarded address. The next line asks the guest instead of guessing: it
  # pins `Port 22` and `ListenAddress 0.0.0.0` in the drop-in, restarts, and prints the listening
  # sockets and the unit's own state so the answer is in the recording either way.

step "pin port 22 and show what the guest is actually listening on"
  run "sudo -n sh -c 'printf \"Port 22\\nListenAddress 0.0.0.0\\n\" > /etc/ssh/sshd_config.d/98-port.conf'; sudo -n systemctl restart sshd; sleep 3; sudo -n ss -ltnp; sudo -n systemctl is-active sshd; sudo -n sshd -T 2>/dev/null | grep -iE \"^(port|listenaddress)\""
  settle 12
  terminal_wait 0


step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"
  timeout 120


step "prove the account over ssh"
  ssh "id -un; hostname"
  timeout 120


step "make sure the host keys exist"
  ssh "set -e\nprintf '%s\\n' '{{ password }}' | sudo -S -p '' mkdir -p /etc/ssh\nprintf '%s\\n' '{{ password }}' | sudo -S -p '' ssh-keygen -A 2>&1 | tail -4\necho \"--- the keys ---\"\nls -l /etc/ssh/ssh_host_*_key | head -8\necho \"--- and the one sshd needs first ---\"\nprintf '%s\\n' '{{ password }}' | sudo -S -p '' test -s /etc/ssh/ssh_host_ed25519_key\n"
  timeout 120


step "restart sshd now that the keys are on disk"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' systemctl restart sshd 2>&1 | tail -3\nsleep 2\nsystemctl is-active sshd\nss -lnt 2>/dev/null | grep ':22 ' || apt-get --version >/dev/null 2>&1 || true\n"
  timeout 180


step "enable sshd again, over ssh, where the exit status is readable"
  # THE LOGIN SHELL IS PART OF THE CONTRACT: this disk's vmuser is fish, and every
  # `ssh:` here is POSIX sh. MEASURED with the engine's own client: `fish -c 'set -e ...
  # test ...'` answers "set: --erase: option requires an argument" (set -e in fish is
  # set --erase, not errexit); CI run 45913042417, the first with the ssh password right,
  # died on `read what this boot did` on exactly such a command.
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' chsh -s /bin/bash vmuser 2>&1 | tail -2; printf '%s\\n' '{{ password }}' | sudo -S -p '' systemctl enable --now sshd 2>&1 | tail -3\nsystemctl is-enabled sshd\ntest \"$(systemctl is-enabled sshd)\" = \"enabled\"\n"
  timeout 180


step "prove sshd will start at boot"
  ssh "set -e\necho \"is-enabled: $(systemctl is-enabled sshd)\"\necho \"is-active:  $(systemctl is-active sshd)\"\necho \"wants:      $(ls /etc/systemd/system/multi-user.target.wants/sshd.service 2>&1)\"\ntest \"$(systemctl is-enabled sshd)\" = \"enabled\"\ntest -L /etc/systemd/system/multi-user.target.wants/sshd.service\n"
  timeout 120

  # `optional` IS GONE AND THE TOLERANCE IS IN THE COMMAND. A reboot that works also closes this
  # connection, so the client reports a failure for a machine that is rebooting exactly as asked -
  # writing `|| true` says that where the log shows it, and `come back up with sshd answering` below
  # is the assertion. `optional` would have swallowed a reboot that never started too.

# A REBOOT INSIDE THE GUEST, NOT A STOP AND A BOOT.
#
# MEASURED on run 45954000516: the ssh leg had FULLY PASSED - `machine_ssh: ssh_ready="true"` is in
# that run's log - and the file then failed at
#
#	after the restart - boot the machine again: boot: could not create an overlay over
#	run-overlay.qcow2: qemu-img: ... Trying to create an image with the same filename as the backing file
#
# because the stop-and-boot pair leaves the daemon's own run-overlay.qcow2 as the backing file. The
# earlier comment's objection ("qemu never stops, so machine_stopped can never be observed") is
# answered by NOT trying to observe a process exit: reboot the guest, and wait for sshd to answer
# again - which is a fact about the guest, and exactly what the stage has just proved it can measure.
step "restart the machine"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' systemctl reboot || true"
  timeout 120


step "the guest has gone down - the old sshd stops answering"
  settle 20


step "after the restart - wait for sshd"
  repeat
    until machine_ssh
    max 90
    pause 10


step "read what this boot did"
  ssh "set -e\necho \"--- identity, over a connection that did not exist when sshd was installed ---\"\nid -un; hostname\necho \"--- is-enabled / is-active ---\"\nsystemctl is-enabled sshd; systemctl is-active sshd\necho \"--- the unit's own account of this start ---\"\njournalctl -b -u sshd --no-pager 2>&1 | tail -12\ntest \"$(systemctl is-enabled sshd)\" = \"enabled\"\ntest \"$(systemctl is-active sshd)\" = \"active\"\n"
  timeout 120


step "ask the guest to power off"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' poweroff"
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
    save "{{ out }}"

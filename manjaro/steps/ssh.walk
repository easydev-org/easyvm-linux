walkthrough "linux-manjaro - sshd"
resolution 1920x1080
recording_resolution 1920x1080
# THE ACCOUNT IS `vmuser`, AND THAT TOOK FIXING THE INSTALL RATHER THAN THIS STAGE.
#
# MEASURED ON RUN 44599025471: Calamares fills the login name from the full name as it is typed, so
# both fields carried `{{ user }}`, the second `type:` APPENDED to the field instead of replacing it,
# and the disk was built with the account `vmuservmuser`. This stage then logged in as `vmuser`,
# which did not exist, and sshd answered `unable to authenticate ... no supported methods remain`.
#
# THE EARLIER ANSWER WAS TO LOG IN AS THE DOUBLED NAME - `user: vmuservmuser` here and in
# vm-configure - which made three stages agree on a wrong account. The install now types `VM User`
# into the full-name field and `{{ user }}` into the login name, so the account is `vmuser` again and
# this file says so.
#
# `ssh_user` IS THE HEADER KEY THE SSH CLIENT READS - `var user` IS NOT.
#
# MEASURED ON RUN 44611943331 (manjaro), whose failure was NOT a refused port but
#
#	wait for sshd: the port is open but no shell answers: ssh: handshake failed: ssh: unable to
#	authenticate, attempted methods [none password], no supported methods remain
#
# - the daemon reached the guest and offered the WRONG NAME. `repeat until machine_ssh` and every `ssh ==`
# step authenticate as `File.SSHUser`, which is parsed from a top-level `ssh_user:` key
# (internal/walk/walk.go) and defaults to `vmuser`. Setting `var user` changes what gets TYPED on
# the console; it does not change who the client logs in as.
user vmuser
var out
  default out/distro.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user


# THERE IS NO LOGIN, NO TERMINAL AND NO install HERE, AND THAT IS THE POINT.
#
# This stage used to type its way through a greeter and a dozen commands in a terminal, and
# MEASURED over ten runs of its sibling zorin the virtual keyboard drops and doubles characters
# at line boundaries - one lost `'` leaves bash at a `>` prompt that swallows every later
# command, so `wait for sshd` ran against a machine whose install had never executed.
#
# The disk this leg pulls has had an ssh server put into it BEFORE its first boot, by
# `scripts/seed-ssh.sh` (see the `seed` row in the workflow), together with the offline half of
# vm-configure: hostname, time zone, locale, automatic login and the screen-lock settings.
#
# So the only work left is to boot it and to check that the promise holds: a session, a kernel,
# an account. Not one keystroke.


step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900


step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"
  timeout 120


step "prove the account over ssh"
  ssh "id -un; hostname"
  timeout 120


step "ask the guest to power off"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' poweroff"
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
    save "{{ out }}"

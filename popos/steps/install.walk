walkthrough "popos - the COSMIC installer walk, 26.04 LTS"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user
step "the media this stage boots from is already on disk"
  needs [popos.iso]


step "create the empty disk"
  disk
    file disk.qcow2
    size 128


step "boot the installer"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=popos.iso,media=cdrom,readonly=on,if=none,id=media0"], ["-device", "ide-cd,drive=media0,bootindex=0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 1800


# POP!_OS 26.04 IS A DIFFERENT INSTALLER FROM 24.04, AND THIS FILE WAS REWRITTEN FOR IT.
#
# MEASURED by driving the whole install by hand on the published media, 2026-11-26. The old file drove
# popOS' GNOME-shell installer - a search in the app grid, a language page, a keyboard page, a separate
# disk page and a separate account page. 26.04 ships the COSMIC installer, which is ONE window with a
# fixed 852x602 frame at (534,130) and a wizard inside it:
#
#	1  Select a Language      a list, `English` preselected
#	2  Keyboard Layout        `English (US)` preselected
#	3  keyboard variants      `Default` preselected
#	4  Install                two cards: `Clean Install`, `Custom (Advanced)`
#	5  Select a drive         the virtio disk as a card
#	6  Create User Account    `Full Name` + `User Name`, then a SECOND pane for the passwords
#	7  Drive Encryption       `Don't Encrypt` / `Set Password` / `Encrypt`
#	8  install                `Partitioning Drive` then `Extracting Files`
#
# THE OLD FILE'S `wait for the live desktop` WAITED FOR A DOCK IMAGE (`reference/desktop.png`) THAT
# 26.04 DOES NOT DRAW THE SAME WAY. THIS ONE WAITS FOR THE INSTALLER WINDOW ITSELF, which is the only
# thing this stage actually needs.
#
# THE INSTALLER SOMETIMES OPENS BY ITSELF AND SOMETIMES DOES NOT, AND BOTH WERE MEASURED ON THIS MEDIA:
#
#	hand run       the window appeared about 155 seconds in, unprompted
#	scripted run   the session drew its wallpaper and its top panel and then sat there for a ten-minute
#	               budget with no window at all
#
# SO NEITHER "wait for it" NOR "always launch it" IS RIGHT ON ITS OWN. A SHORT WAIT, THEN THE LAUNCHER,
# THEN A PROPER WAIT - and the `esc` between them is what makes both cases safe:
#
#	the wizard was already up   `meta_l` covers it, `esc` closes the launcher, the wizard is back
#	the wizard was not up       `meta_l` opens the launcher, `install` finds it, Enter starts it
#
# AN UNCONDITIONAL LAUNCHER WAS TRIED FIRST AND IS WRONG: it steals the keyboard from a wizard already on
# screen, and the next step then clicks into a window that no longer has focus.
#
# EVERY `Select`/`Next` BUTTON IS AT THE WINDOW'S LOWER RIGHT: (1344,691) while the wizard shows a
# single `Select`, and it shifts left when a second button (`Back`) appears. The measured centres are
# in each step.
# A PLAIN WAIT, NOT A `repeat ... until`. MEASURED: `repeat`'s `until` FAILS when its `max` runs out -
# it does not fall through - so using it as a probe killed the stage on the boot where the wizard had not
# drawn yet. A `settle` costs the same seconds and cannot fail.
#
# THREE MINUTES COVERS BOTH MEASURED CASES: the hand run's window appeared at about 155 seconds, and the
# boot that never starts it has finished drawing its desktop by then - which is what the launcher below
# needs in order to work.
step "give the live session three minutes to start the installer by itself"
  settle 180


step "open the launcher"
  input meta_l
  settle 6

step "search for the installer"
  input text "install"
  settle 6

step "start the one result"
  input ret
  settle 12

step "close the launcher if it was still up"
  input esc
  settle 6


step "the installer window is up"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name inst2
    until
      bind there
      source inst2
      mode text
      rect [534, 130, 1386, 200]
      rect_at [1920, 1080]
      scale 2
      words [[Install, LTS], [Install, Pop!_OS]]
    max 120
    pause 5


# PAGE 1 - LANGUAGE. `English` is the first row and already highlighted, so this only presses Select.
#
# MEASURED: the button does not always take the first press - the window has just drawn and the click
# lands while the row is still being laid out. The second press is harmless if the first worked: by then
# the page is the keyboard list and (1344,691) is its `Select` too, so a doubled press advances at most
# one page and never skips one.
step "language - select"
  input 1344 691
  settle 6

step "language - select again, for a press the first page may not have taken"
  input 1344 691
  settle 8


# PAGE 2 - KEYBOARD LAYOUT, `English (US)` preselected. THE `Select` HERE OPENS THE VARIANT LIST.
step "keyboard - select"
  input 1344 691
  settle 8


# PAGE 3 - THE LAYOUT'S VARIANTS, `Default` preselected.
step "keyboard variants - select"
  input 1344 691
  settle 8


# PAGE 4 - THE INSTALL MODE. `Clean Install` is the first card; pressing it turns the grey `Next` into a
# green `Clean Install` in the same place, and that is what starts the wizard proper.
# THE CARD'S CENTRE IS (1177,371) ON THE FULL FRAME, NOT (1180,380) - AND THE CARD IS SHORT.
#
# MEASURED on the local run: a click at (1180,380) selected `Custom (Advanced)` instead, and the next
# page was the MANUAL PARTITIONER (`Select which partitions to use across all drives...` / `Modify
# Partitions...`) rather than a fresh install. The two cards are 100 pixels apart vertically and the
# first one ends at about y=278 more than a whole card above the second, so this is a click that has to
# land inside the upper card's own row.
# THE CARD'S OWN ROW, AND THEN A CHECK THAT IT IS THE ONE THAT TOOK THE CLICK.
#
# MEASURED: the two cards sit 100 pixels apart, and a click that lands between them leaves the wizard on
# its default selection - which is `Custom (Advanced)`, the MANUAL PARTITIONER. That page then asks
# `Select which partitions to use across all drives` and the run dies on a screen it never expected.
# The click is checked against the button's own label: `Clean Install` is drawn there only when the
# first card is the chosen one, and `Next` when it is not.
step "install - clean install"
  input 1177 368
  settle 6

step "install - the first card is the one that took the click"
  read
    name chosen

step "install - prove it, before the button is pressed"
  repeat
    do
      item
        input 1177 368
        settle 4
      item "read the screen"
        read
          name chosen2
    until
      bind ok
      source chosen2
      mode text
      rect [1155, 675, 1386, 710]
      rect_at [1920, 1080]
      scale 2
      words [[Clean, Install]]
    max 10
    pause 2

step "install - start"
  input 1304 691
  settle 12


# PAGE 5 - THE DRIVE. The card is the only entry; selecting it turns `Erase and Install` red and live.
step "drive - choose the virtio disk"
  input 1174 418
  settle 5

step "drive - erase and install"
  input 1284 692
  settle 15


# PAGE 6 - THE ACCOUNT, FIRST PANE. `Full Name` is the only empty field, and THIS INSTALLER DERIVES THE
# USER NAME FROM IT: typing `VM User` makes the `User Name` box read `vmuser` by itself - measured, and
# it is the same behaviour zorin's ubiquity page has.
#
# THE NAME IS WRITTEN OUT AND THEN OVERWRITTEN, because "derived" is a rule about this build and the
# account every later stage dials is `{{ user }}`. A field that was going to be filled by the installer
# is cleared first, so the value below is the value the disk gets whatever the rule does.
step "account - full name"
  input text "VM User"
    at 1180 454
    clear true
  settle 3

step "account - user name"
  input text "{{ user }}"
    at 1180 520
    clear true
  settle 3

step "account - next, which opens the password pane"
  input 1324 692
  settle 10


# PAGE 6, SECOND PANE - THE PASSWORDS. `Choose Account Password` at y=374 and `Confirm Password` at
# y=476, both measured on the frame.
#
# THE INSTALLER WARNS THAT THIS PASSWORD IS SHORTER THAN EIGHT CHARACTERS and lets it through - the
# warning is `The password is shorter than 8 characters` beside the field, and the `Next` button is
# live regardless. That is recorded here because it is the one place in this repository where the
# organisation's `admin1` meets a policy that would rather it were longer.
step "password - choose"
  input text "{{ password }}"
    at 1180 374
    clear true
  settle 3

step "password - confirm"
  input text "{{ password }}"
    at 1180 476
    clear true
  settle 3

step "password - next, which opens drive encryption"
  input 1324 692
  settle 10


# PAGE 7 - DRIVE ENCRYPTION. `Don't Encrypt` IS THE ANSWER THIS REPOSITORY WANTS, and it is the LEFT of
# three buttons: an encrypted disk asks for a passphrase at every boot, which an unattended client cannot
# type - the same reason macOS' setup assistant is answered with a clear password and pearOS gets
# automatic login.
step "encryption - don't encrypt"
  input 1037 692
  settle 15


# PAGE 8 - THE INSTALL ITSELF. Two captions, `Partitioning Drive` and then `Extracting Files`, and the
# second is the long one: it unpacks the root image onto the disk.
step "the install runs, partitioning then extracting"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name prog
    until
      bind done
      source prog
      mode text
      rect [534, 600, 1386, 700]
      rect_at [1920, 1080]
      scale 2
      words [[Extracting, Installing], [Partitioning], [Finishing]]
    max 60
    pause 5


# THE FINISHED PAGE SAYS `Installation Complete` AND OFFERS A RESTART. It is not the same as "installed":
# the medium still boots, so this stage stops the machine and publishes the disk rather than pressing
# Restart, which is what every other walk in this repository does.
step "the install finishes"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name fin
    until
      bind done
      source fin
      mode text
      rect [534, 200, 1386, 700]
      rect_at [1920, 1080]
      scale 2
      words [[Installation, Complete], [Restart], [installed]]
    max 150
    pause 5


step "give the installer its last few seconds, because \"complete\" is not \"flushed\""
  settle 25


step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
  save "{{ out }}"

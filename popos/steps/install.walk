walkthrough "popos - the pop installer walk"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user
step "the media this stage boots from is already on disk"
  needs [popos.iso]


step "create the empty disk"
  disk disk.qcow2
  disk_gb 128


step "boot the installer"
  boot
  iso popos.iso
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 4096
  os linux
  timeout 1800


step "wait for the live desktop"
  desktop linux/gnome
  poll 5
  range [0.9, 1]
  # THE TOP 120 ROWS ARE NOT GOOD ENOUGH ON THIS MEDIUM, AND THAT IS MEASURED RATHER THAN SUSPECTED.
  #
  # Scored against this medium's own recording, the top band gives a WORST desktop frame of
  # 0.8115 - under the 0.90 the gate asks for. Its menu bar carries a clock and a set of status
  # icons that move, and unlike ubuntu's (0.9816 worst) there is enough of them to lose the gate.
  # A reference band that depends on a clock is a band that fails whenever the minute differs.
  #
  # THE LEFT 300 PIXELS, rows 280..480, are wall paper in every desktop frame: 0.9990 minimum
  # across 63 samples. The installer window does not reach this far left, so the gate does not
  # depend on where the installer happens to be. Boot and splash frames score 0.0000 there.
  rect [0, 280, 300, 480]
  rect_at [1920, 1080]
  reference reference/desktop.png
  timeout 5400


step "open the installer from the dock"
  input 1211 1050
  settle 20


step "the installer window is up"
  repeat
    do
      item
        click [420, 300]
        settle 3
    until
      bind done
      source screen
      mode text
      rect [698, 153, 945, 755]
      rect_at [1920, 1080]
      scale 1
      words [[Install], [Language], [Clean], [Erase], [Account]]
    max 100


step "select the language, all the way to the keyboard page"
  repeat
    do
      item
        click [1367, 810]
        settle 6
    until
      bind there
      source kb
      mode text
      rect [728, 680, 857, 755]
      rect_at [1920, 1080]
      scale 1
      words [[Layout]]
    max 8


step "the keyboard page is up"
  repeat
    pause 3
    until
      bind there
      source kb
      mode text
      rect [728, 680, 857, 755]
      rect_at [1920, 1080]
      scale 1
      words [[Layout], [Type]]
    max 20


step "the keyboard layout, which is US"
  input 1190 696
  settle 3


step "the layout types latin letters - click the field"
  input 1190 757


step "the layout types latin letters - select what is there"
  input ctrl+a
  settle 1


step "the layout types latin letters - delete the selection"
  input backspace
  settle 1


step "the layout types latin letters - type the value"
  input text 
  type_gap 0.12
  settle 1


step "take the keyboard layout"
  input 1367 810
  settle 6


step "the install page is up"
  repeat
    pause 3
    until
      bind there
      source inst
      mode text
      rect [1012, 391, 1105, 548]
      rect_at [1920, 1080]
      scale 1
      words [[Clean], [Custom]]
    max 20


step "clean install"
  input 1000 433
  settle 3


step "install"
  input 1367 810
  settle 6


step "the drive page is up"
  repeat
    pause 3
    until
      bind there
      source drv
      mode text
      rect [726, 458, 1217, 748]
      rect_at [1920, 1080]
      scale 1
      words [[drive], [Virtio]]
    max 20


step "select a drive"
  input 1185 497
  settle 4


step "erase and install"
  input 1367 810
  settle 10


step "wait for the account pane"
  repeat
    pause 2
    until
      bind done
      source screen
      mode text
      rect [731, 533, 1021, 790]
      rect_at [1920, 1080]
      scale 1
      words [[Account], [User]]
    max 45


step "type the display name - click the field"
  input 1190 530


step "type the display name - select what is there"
  input ctrl+a
  settle 1


step "type the display name - delete the selection"
  input backspace
  settle 1


step "type the display name - type the value"
  input text 
  type_gap 0.09
  settle 2


step "create user account, and wait for the password pane"
  repeat
    do
      item
        click [1367, 816]
        settle 8
    until
      bind there
      source pw_pane
      mode text
      rect [943, 383, 1161, 544]
      rect_at [1920, 1080]
      scale 3
      words [[Confirm], [Password]]
    max 6
# THE PASSWORD IS ONLY TYPED WHEN THE PASSWORD PANE IS ACTUALLY UP.
#
# MEASURED ON THE PUBLISHED DISK (linux-popos, 2026-11-21T19:00): its greeter reads
#
#	adminadmin
#
# as the ACCOUNT NAME. That is the password, typed twice, into the ACCOUNT PAGE's name field -
# so this step's two fixed coordinates (1200,448) and (1200,544) landed on the page BEFORE the
# password pane, and the install then created an account called `adminadmin` with an unknown
# password. Every ssh stage against that disk fails at the greeter with
# `pam_authenticate: AUTH_ERR`, which is what three runs of this workflow spent their time on.
#
# THE GUARD IS THE PANE'S OWN LABELS. `Confirm` and `Password` are drawn on the password pane and
# THE PANE IS WAITED FOR, NOT GATED ON A GUARD THAT CAN ALSO SKIP THE REAL PAGE.
#
# THE FIRST VERSION OF THIS FIX WAS WRONG IN THE OTHER DIRECTION, AND THE NEXT RUN PROVED IT: a
# `when:` on the pane's labels skips the step when the reader does not see them - and the two
# password fields were then never typed. The disk it published has an account whose password is not
# this walk's, so its greeter answers `pam_authenticate: AUTH_ERR` and no password logs in.
#
# A `when:` IS THE WRONG INSTRUMENT FOR "WAIT UNTIL": it is a gate, and a gate that mis-reads
# silently removes the step. The loop below RETRIES until the pane is there - pressing nothing but
# `Next`, which is what got here - and the two steps after it are then unconditional, so the fields
# are always typed once the pane is up.


step "prove the password pane is up before typing into it"
  repeat
    pause 4
    until
      bind there
      source pw2
      mode text
      rect [930, 350, 1400, 570]
      rect_at [1920, 1080]
      scale 2
      words [[password], [confirm]]
    max 12


step "type the password - click the field"
  input 1200 448


step "type the password - select what is there"
  input ctrl+a
  settle 1


step "type the password - delete the selection"
  input backspace
  settle 1


step "type the password - type the value"
  input text 
  type_gap 0.09
  settle 2


step "confirm the password - click the field"
  input 1200 544


step "confirm the password - select what is there"
  input ctrl+a
  settle 1


step "confirm the password - delete the selection"
  input backspace
  settle 1


step "confirm the password - type the value"
  input text 
  type_gap 0.09
  settle 2
# AND THE TWO FIELDS ARE READ BACK, BECAUSE A FIELD THAT DID NOT TAKE IS AN ACCOUNT NOBODY CAN USE.
# The password box shows dots, so what is checked is that SOMETHING is in each row.


step "prove both password rows hold characters"
  repeat
    pause 3
    until
      bind filled
      source pwdots
      mode matches
      pattern ".{4,}"
      rect [960, 430, 1400, 570]
      rect_at [1920, 1080]
      scale 3
    max 6
# AND THE NAME FIELD IS READ BACK WHERE IT CAN STILL BE SEEN - ON THE ACCOUNT PAGE, BEFORE
# `Next` IS PRESSED, because a disk that installs an account nobody can log into looks exactly
# like a successful install and only fails twenty minutes later in the ssh stage.
#
# The read happens in the `type the display name` loop above (`words: [[VM], [User]]`), which is
# what proves the field took the text; this comment is the record of why that read is not optional.


step "account password next"
  input 1367 810
  settle 25


step "drive encryption - don't encrypt"
  input 1367 810
  settle 15


step "the install has started"
  repeat
    pause 6
    until
      bind begun
      source started
      mode text
      rect [491, 722, 598, 784]
      rect_at [1920, 1080]
      scale 3
      words [[Extracting], [Installing], [Copying]]
    max 20
  settle 35


step "the install is written"
  disk_min_mb 512
  disk_settle 180
  poll 20
  timeout 3600


step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
  save "{{ out }}"

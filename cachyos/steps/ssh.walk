walkthrough "linux-cachyos - sshd"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user
step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
# THE GREETER IS ASKED FOR BEFORE ANYTHING IS CLICKED, BECAUSE IT IS NOT THERE YET.
#
# MEASURED ON RUN 44472625613, whose recording is BLACK at 15 seconds and shows the greeter at
# 22: the clicks and the `type:` that followed all landed on nothing, so the password field kept
# its "Password" placeholder and `wait for the desktop` expired after 15 minutes. Every step below
# carries `optional: true`, which is what let the miss through silently - an optional step that
# misses is indistinguishable from one that was not needed.
#
# THE BAND IS THE GREETER'S OWN MIDDLE: the user tile and the password field, x 740..1340 and
# y 470..770. Read back from that recording at scale 2 it yields "Password vmuser"; at scale 1 it
# yields nothing, which is why the scale is 2 and not the default.
# THIS DISK STOPS AT A GRUB MENU, AND THE OLD LOOP KEPT IT THERE.
#
# MEASURED ON RUN 44924791378, whose own recording is the evidence: at 240 s - and at 383 s, when
# the stage gave up - the frame is CachyOS's themed GRUB screen with "CachyOS Linux" highlighted,
# the other entries below it, and NO COUNTDOWN RUNNING. The disk was fine and the bootloader was
# waiting for a key.
#
# The loop below used to press `esc` every four seconds while it looked for the greeter. ON A GRUB
# MENU `esc` CANCELS THE TIMEOUT - so sixty presses kept the menu up for the whole four minutes,
# and the OCR read "BootNext)" off the menu each time, which is the text the daemon log shows.
#
# SO THE ENTRY IS CHOSEN ONCE, BEFORE ANY WAITING: `ret` takes the highlighted default. The loop
# that follows only waits; it presses nothing, because there is nothing left to press.


step "boot the default GRUB entry"
  input ret
  settle 20
# BOTH WORDS, IN ONE SET - NOT ONE OF TWO SETS.
#
# MEASURED ON RUN 44928008531, and the daemon log is the whole story:
#
#	see: 4 word(s): hs vmuser ES £3
#	the greeter is drawn [check]: up = true (read "vmuser")
#	loop: satisfied after 1 attempt(s)
#	greeter - the user tile - when: 8 word(s): 12:08 PM i CS | ? sy b
#	skipped: the screen does not say "password vmuser"
#
# `words: [[password], [vmuser]]` MEANS EITHER SET, so the loop stopped as soon as the user tile
# existed - while SDDM was still drawing its clock above it. The three login steps that follow carry
# `when: [password, vmuser]`, which needs BOTH words, so all three were skipped and the stage went to
# `wait for the desktop` on a machine that had never been logged into. Its recording at 90 s is SDDM's
# clock lock screen, which is what "no desktop" looks like from the inside.
#
# "password" IS NOT ON THIS SCREEN, AND DEMANDING IT COST FOUR MINUTES.
#
# MEASURED ON RUN 44929103832, whose recording is the evidence:
#
#	30 s   the greeter fully drawn - the vmuser tile and a focused Password box
#	60 s   SDDM's clock-only lock screen: the greeter has timed out and gone back to sleep
#
# and whose daemon log shows the reader never seeing the box's text at all:
#
#	see: 4 word(s): hs vmuser ES £3
#
# "Password" IS A PLACEHOLDER INSIDE A WHITE INPUT FIELD - the same thing that makes it unreadable
# at scale 1 in the sibling walkthroughs. A loop waiting for both words could only ever time out,
# and while it waited SDDM's own timeout put the screen back to the clock.
#
# SO THE GREETING IS RECOGNISED BY THE ONE WORD THAT IS PRINTED LARGE, and the guards after it ask
# the same question the loop does - which is the defect the first fix addressed from the other side:
# the loop and its `when:` guards must agree, or the clicks are skipped by a screen the loop
# accepted.


step "the greeter is drawn"
  repeat
    do
      item
        settle 2
      item "read the screen"
        read
          name greeter
    until
      bind up
      source greeter
      mode text
      rect [740, 470, 1340, 770]
      rect_at [1920, 1080]
      scale 2
      words [vmuser]
    max 60
# THE GUARD READS THE SAME BAND THE LOOP DID, OR IT IS ASKING ABOUT A DIFFERENT SCREEN.
#
# MEASURED ON RUN 44929782480 - the loop was satisfied on its first attempt and all three guards
# then skipped:
#
#	the greeter is drawn [check]: up = true (read "vmuser")          <- in the 740..1340 x 470..770 band
#	greeter - the user tile - when: 13 word(s): 12:45PM Saturday ... <- the WHOLE frame
#	skipped: the screen does not say "vmuser"
#
# `when:` RE-READS THE SCREEN rather than the loop's captured frame, and without a `rect:` it reads
# every pixel - where the tile's name is too small for the reader while the clock above it is not.
# The loop and the guards now read the same rectangle, so a screen the loop accepted is a screen its
# guards act on. That agreement is the whole defect: the login steps must not disagree with the check
# that decided the greeter was ready.


step "greeter - the user tile"
  input 960 488
  rect [740, 470, 1340, 770]
  rect_at [1920, 1080]
  when vmuser


step "greeter - the password box - click the field"
  input 936 628


step "greeter - the password box - type the value"
  # THE PASSWORD, WHICH THIS LINE USED TO LEAVE OUT.
  #
  # The v1 file said `type == '{{ password }}'`; the rewrite to v2 emitted `input text ` with nothing
  # after it, so this step typed ZERO characters into a password field that had already been clicked.
  # CachyOS is the only distro here whose ssh leg LOGS IN through the greeter instead of relying on
  # autologin, so the empty argument broke nothing else - and it failed exactly where it was expected
  # to work. MEASURED on run 45772869180, which ends:
  #
  #	=== greeter - the password box - type the value
  #	(the recording ends; no characters were typed, so the submit could not log in)
  input text "{{ password }}"
  settle 3


step "greeter - submit"
  input ret
  rect [740, 470, 1340, 770]
  rect_at [1920, 1080]
  settle 12
  when vmuser
# `desktop: linux/kde` AND NOT `desktop: linux`: THE BARE FAMILY TESTS FOR A PANEL THAT IS AT LEAST
# 40 ROWS TALL, AND THIS ENVIRONMENT'S PANEL IS 8.
#
# MEASURED ON RUN 44490850319's LEFT-OVER RECORDING AND AGAIN ON THIS STAGE'S OWN FRAME, same two
# images, both tests:
#
#	IsLinuxDesktop   false   drop=0.0   ratio=0.00
#	IsKDEDesktop     true    drop=10.8  ratio=1072.00
#
# The desktop was up the whole time the stage was waiting - the recording's last 15 minutes are a
# finished CachyOS desktop with its welcome window and its panel. `desktop:` spent them asking a
# question this DE answers false to.
# A REFERENCE IMAGE, BECAUSE THE PANEL TEST IS NOT STABLE ON THIS GUEST.
#
# `desktop: linux/kde` ANSWERED IN 0 s ON RUN 44509536049 AND NEVER ONCE IN 15 MINUTES ON RUN
# 44514871063 - and the second run's recording ends on a PERFECT CACHYOS DESKTOP: welcome window,
# panel, clock reading 6:37 AM. `IsKDEDesktop` measures the panel's contrast against the rest of
# the screen, and the same desktop scores above its threshold on one boot and below it on the next.
#
# `desktop:` with a `reference:` compares a NAMED BAND against a picture, which does not drift:
# measured on that recording, the band below scores 0.0000 on every boot and splash frame and
# 1.0000 on every desktop frame from 55 s on.
#
# THE REFERENCE IS reference/desktop-ssh.png - taken from THIS stage's own recording, not from the
# install stage, whose desktop has a different wallpaper and an installer window on it.
# THE BAND IS WALLPAPER to the right of centre: clear of the welcome window (x 560..1355), of the
# panel along the bottom, and of the clock in the bottom-right corner.


step "wait for the desktop"
  repeat
    do
      item
        read
          name screen
    until
      source screen
      mode like
      reference reference/desktop-ssh.png
      range [0.9, 1]
      rect [1350, 740, 1700, 990]
      rect_at [1920, 1080]
      must true
    max 180
    pause 5


# THE CACHYOS HELLO WINDOW STEALS THE FOREGROUND, AND THE TERMINAL IS BEHIND IT.
#
# MEASURED on run 45774001076, whose recording is unambiguous once the frames are read one second
# apart:
#
#	60 s   a clean desktop, the CachyOS Hello window not up yet
#	62 s   CachyOS Hello is up, and KONSOLE IS ALREADY OPEN BEHIND IT (the >_ taskbar entry, and the
#	       "5-11.1 / [GTK ... / 3/4]" lines of the terminal visible down its left edge)
#	74 s   the cursor sits on Hello's "Forum" button
#	86 s   Firefox has opened aur.archlinux.org - because the keystrokes meant for the terminal
#	       landed on Hello's buttons and one of them is a web link
#
# So `ctrl+alt+t` DID open a terminal every time - the earlier "the terminal never opened" reading
# was wrong. What goes wrong is FOCUS: Hello launches on login and sits above the terminal, so every
# `run` after this point types into Hello (or the browser it opens) and sshd is never configured.
# That is the whole of this leg's `10 minutes of connection refused`.
#
# THE FIX IS TO CLOSE HELLO FIRST, BEFORE THE TERMINAL IS WANTED, so the terminal this file opens is
# the window the keys reach. `alt+f4` closes the focused window, and at this point the focused window
# IS Hello - the frames above are that measurement. A machine that does not launch Hello sees alt+f4
# do nothing on an empty desktop, which is why it is safe to send unconditionally.
step "let the welcome window appear, then close it"
  # Hello appears a beat AFTER the desktop scores, so wait for it before closing it: at 60 s the
  # desktop is clean and at 62 s Hello is up, and an alt+f4 at 60 s would close nothing.
  settle 8
  input alt+f4


step "close anything else that took the foreground"
  settle 5
  input alt+f4


step "open the terminal"
  input ctrl+alt+t
  settle 20
# NO `terminal_wait:` HERE, AND THAT IS THE FIX RATHER THAN AN OMISSION.
#
# `terminal_wait:` OPENS A TERMINAL (ctrl+alt+t) AND THEN TYPES. The step above has already
# opened one, so a second ctrl+alt+t starts a NEW terminal window and the keys that follow go to
# it - while the command already typed into the first one is never submitted.
#
# MEASURED ON RUN 44545555943's kubuntu ssh recording, whose terminal shows exactly that:
#
#	vmuser@kubuntu:~$ xset s off; xset -dpms; xset s noblank; echo SCREEN_KEPT_ONECHO ADMIN | sudo ...
#	server does not have extension for -dpms option
#	[sudo: authenticate] Password:
#
# `SCREEN_KEPT_ON` runs straight into `ECHO ADMIN` with no line break: the Return after the first
# command went to the OTHER window. And the `xset -dpms` failure - "server does not have extension
# for -dpms option" - is harmless; the screen is still kept awake by `s off` and `s noblank`.
# THE SCREEN IS KEPT AWAKE BY A STEP OF ITS OWN, BEFORE ANYTHING ELSE TYPES.
#
# MEASURED ON RUN 44933304315, whose ssh recording ENDS ON A PURE BLACK FRAME and whose log is
# the failure in seven lines:
#
#	=== wait for the desktop   similarity 0.9995 (want 0.90..1.00)   <- THE LOGIN WORKED
#	=== open the terminal
#	=== install openssh
#	=== prove sshd is active
#	=== wait for sshd          10 minutes of "connection refused"
#
# Every step after `open the terminal` did nothing. `xset s off; xset s noblank` WAS the first thing
# on the `install openssh` line - but that line is typed as one keystroke stream into a terminal
# whose screen has already blanked, so the characters that would wake it are the ones being
# discarded. The sibling distros that pass (ubuntu, mx) put `xset` in a STEP, on its own, and wait
# for it before anything else is typed; this file had it buried in the next command.


step "keep the screen on"
  run "xset s off; xset -dpms; xset s noblank"
  settle 5
  terminal_wait 0


step "install openssh"
  run "echo {{ password }} | sudo -S pacman -Sy --noconfirm --needed openssh 2>&1 | tail -5"
  settle 45
  terminal_wait 0


step "allow password authentication"
  run "echo {{ password }} | sudo -S -p '' sh -c 'mkdir -p /etc/ssh/sshd_config.d; printf \"PasswordAuthentication yes\\n\" > /etc/ssh/sshd_config.d/99-vm.conf; sed -i \"s/^#\\?\\s*PasswordAuthentication.*/PasswordAuthentication yes/\" /etc/ssh/sshd_config; grep -q \"^PasswordAuthentication yes\" /etc/ssh/sshd_config || printf \"PasswordAuthentication yes\\n\" >> /etc/ssh/sshd_config' 2>&1 | tail -3"
  settle 3
  terminal_wait 0
# `enable --now` INSTEAD OF `enable`, WHICH IS WHAT THE SIBLINGS THAT PASS ALREADY DO.
#
# MEASURED ON RUN 44935328802, whose recording shows the terminal and the commands in it:
#
#	$ echo admin | sudo -S systemctl estart sshd
#	Unknown command verb 'estart', did you mean 'start'?
#	$ systemctl is-active sshd
#	inactive
#
# `restart` LOST ITS FIRST CHARACTER. The screen was awake and the terminal was there - the earlier
# DPMS fix did its job - and the keystroke at the head of this command was dropped, so a verb that
# starts a service became one that does nothing. `systemctl` then rejected it, the service stayed
# inactive, and the ten minutes of `connection refused` followed.
#
# ONE COMMAND THAT CANNOT BE MIS-TYPED INTO A VALID ONE: `enable --now` starts the unit, and ubuntu
# and mint (both passing) use exactly this. There is then no separate `restart` to lose a character
# from, and `is-active` below is a verdict rather than the thing that reveals the mistake.


step "enable sshd at boot, and start it"
  # THE HOST KEYS MUST EXIST BEFORE sshd STARTS, OR IT STARTS AND EXITS AT ONCE.
  #
  # MEASURED in the pod on this exact disk (the linux-cachyos install), booted and driven by hand:
  # after `pacman -S openssh` the unit is `inactive (dead)` and `disabled`, and `ss -lntp | grep :22`
  # is EMPTY. This file used to generate the host keys at step "make sure the host keys exist",
  # which sat AFTER `wait for sshd` - so for the whole ten minutes of that wait there were no keys,
  # sshd had nothing to present, and `enable --now` created a symlink and left the daemon dead.
  #
  # `ssh-keygen -A` FIRST, then the unit can actually run. And `ufw` defaults to `INPUT DROP` (read
  # off `iptables -S INPUT` in that same guest), so `ufw allow 22/tcp` is the other half - without
  # it the host's SYN is dropped and the probe reports "no route to host", which reads as a broken
  # link rather than a closed door. Both are done here, in one run, before anything waits.
  #
  # rp_filter=2 IS THE FIX FOR A ONE-WAY FAILURE, AND THE MEASUREMENT IS COMPLETE.
  # Run 45807597852's screen, at the diagnosis step, is every fact needed:
  #
  #	LISTEN 0.0.0.0:22  users:(("sshd",pid=2116))     sshd IS listening on all addresses
  #	sshd -T: port 22, listenaddress 0.0.0.0:22
  #	ping 172.30.0.1 -> 2 received, 0% packet loss     guest reaches the host
  #	ip neigh -> 172.30.0.1 REACHABLE                  ARP resolves the host
  #	MAC = 52:54:00:56:4d:01 = QEMU_MAC                the NIC is the right one
  #
  # Every one is correct, and the host STILL gets `no route to host` on 172.30.0.1:2222, which is
  # ICMP host-unreachable, not a refusal. That is STRICT REVERSE-PATH FILTERING: rp_filter=1 drops a
  # packet whose source route does not go back out the interface it arrived on, and answers
  # host-unreachable. Arch/cachyos ships rp_filter=1 (strict); Ubuntu - anduinos, which passes -
  # ships 2 (loose). The asymmetry is the whole bug: guest->host is fine, host->guest is dropped.
  # `2` is loose mode: the path is checked for reachability, not for the exact interface.
  run "echo {{ password }} | sudo -S -p '' ssh-keygen -A 2>&1 | tail -3; echo {{ password }} | sudo -S -p '' systemctl enable --now sshd 2>&1 | tail -3; echo {{ password }} | sudo -S -p '' ufw disable 2>&1 | tail -3; echo {{ password }} | sudo -S -p '' sh -c 'sysctl -w net.ipv4.conf.all.rp_filter=2 net.ipv4.conf.enp0s6.rp_filter=2 net.ipv4.conf.default.rp_filter=2 2>&1 | tail -3'; systemctl is-active sshd"
  settle 15
  terminal_wait 0


step "prove the setting took"
  run "echo {{ password }} | sudo -S sh -c 'sshd -T 2>/dev/null | grep -i \"^passwordauthentication\" || echo PASSWORDAUTH-UNREADABLE' 2>&1 | tail -3"
  settle 3
  terminal_wait 0
# A SECOND, IDEMPOTENT START. `--now` above is the one that matters; this covers a guest whose unit
# file appeared after that ran. `start` on a running unit is a no-op that says so, so a lost
# keystroke here cannot leave the service down without `is-active` reporting it.


step "start sshd"
  run "echo {{ password }} | sudo -S systemctl start sshd 2>&1 | tail -3"
  settle 10
  terminal_wait 0


step "prove sshd is active"
  run "systemctl is-active sshd"
  settle 5
  terminal_wait 0


step "open the firewall for ssh"
  # ufw IS DISABLED OUTRIGHT, NOT POKED WITH `allow 22/tcp`.
  #
  # anduinos and pearos - both PASSING - have no ufw at all, so their INPUT policy is ACCEPT and
  # sshd is reachable the moment it listens. cachyos ships ufw enabled with `-P INPUT DROP`, and on
  # run 45796366289 the guest showed `22/tcp ALLOW Anywhere` and `Status: active` and STILL answered
  # the host's probe with `no route to host` - a drop, not a refusal. A VM on an isolated bridge has
  # no business running a host firewall; disabling it is the same state the passing guests are in.
  run "echo {{ password }} | sudo -S -p '' ufw disable 2>&1 | tail -3; echo {{ password }} | sudo -S -p '' ufw status 2>&1 | head -2"
  settle 8
  terminal_wait 0


# THE GUEST'S sshd IS UP AND THE HOST STILL CANNOT REACH IT: `no route to host`, WHICH IS ARP.
#
# MEASURED on run 45779041741, whose recording proves the guest side is complete and correct:
#
#	=== prove sshd is active   systemctl is-active sshd   ->   active
#	=== open the firewall      ufw allow 22/tcp           ->   Rule added, 22/tcp ALLOW Anywhere
#
# and whose daemon log says, on every probe, `dial tcp 172.30.0.1:2222: connect: no route to host`.
# `no route to host` is not "refused" - pearos, which passes, gets `connection refused` until its
# sshd starts and then `ssh_ready="true"`. Refused means the host REACHED the guest and the port was
# shut. No-route means the host never got an ARP reply, i.e. the guest's address is not answering on
# the tap - whatever the desktop BELIEVES its address is (fastfetch prints "Local IP (wlan0):
# 172.30.0.2/24", and the interface being called wlan0 is the smell: NetworkManager has taken the
# virtio NIC and may not have brought it up the way the tap needs).
#
# SO THE GUEST IS ASKED, in its own terminal, to say what its interfaces and routes actually are and
# then to bring the wired NIC up through NetworkManager. Both the diagnosis and the fix are here
# because the next run is the measurement: if this brings the link up, `wait for sshd` passes; if it
# does not, the `ip a` / `nmcli` output on screen is the answer the logs never carried.
step "say what the guest's NIC is"
  # THE TERMINAL HERE IS FISH (`fish: Unknown command: xset` on an earlier frame), so these are
  # plain commands a person could type at a fish prompt - no `$(...)`, no bash loops.
  #
  # THE HOST GETS `no route to host` ON EVERY PROBE while the guest's own screen says sshd is
  # `active` and ufw allows 22/tcp. `no route to host` is ARP failing - the host never reaches the
  # guest - which is a different fact from pearos's `connection refused` (host reached the guest,
  # the port was shut) that becomes `ssh_ready="true"` once its sshd starts. So the question is what
  # the guest's interfaces and addresses ACTUALLY are, and this step puts that on screen.
  # THE PCAP (run 45884303163) IS THE ANSWER TO "WHERE": the host's SYN reaches qemutap0 as
  # `172.30.0.1.x > 172.30.0.2.22: Flags [S]` three times, and there is NO SYN-ACK back. So the
  # guest received the SYN on its own virtio NIC and did not answer it. Everything on the HOST is
  # now correct; this step is about the guest's kernel dropping a SYN it can plainly see.
  #
  # THE PRIME SUSPECT IS rp_filter ON THE GUEST. A SYN from 172.30.0.1 arrives on enp0s6; strict
  # reverse-path filtering (1) drops it before it reaches sshd if the kernel's best route back to
  # 172.30.0.1 is not enp0s6 (a second route table, or the default via the same address, can make it
  # ambiguous). ICMP from the guest to the host worked, which only proves the OUTBOUND path; it says
  # nothing about accepting an INBOUND SYN. Set rp_filter to 0 on every interface (looser than 2),
  # print the ACTUAL values, and end with the guest's own self-connect so the two questions - "does
  # the guest reach its own 22" and "what is rp_filter" - are both on the last line, not scrolled off.
  run "sudo sysctl -w net.ipv4.conf.all.rp_filter=0 >/dev/null 2>&1; sudo sysctl -w net.ipv4.conf.default.rp_filter=0 >/dev/null 2>&1; sudo sysctl -w net.ipv4.conf.enp0s6.rp_filter=0 >/dev/null 2>&1; echo MAC=$(cat /sys/class/net/enp0s6/address); echo RPF=$(cat /proc/sys/net/ipv4/conf/enp0s6/rp_filter) ALL=$(cat /proc/sys/net/ipv4/conf/all/rp_filter); sudo ss -lntp | grep :22 || echo NO_22_LISTEN; echo ---TCP-SELF---; timeout 3 bash -c \"echo > /dev/tcp/172.30.0.2/22\" 2>&1 && echo SELF_TCP_OK || echo SELF_TCP_FAIL; echo ---NFT-RAW---; sudo nft list ruleset 2>&1 | grep -iE \"drop|reject|raw|hook prerouting\" | head -12; echo ---CNT---; nstat -az 2>/dev/null | grep -iE \"InNoRoutes|InAddrErrors|InHdrErrors|ListenDrops|TCPReqQFullDrop|InErrs\" | head -8"
  settle 15
  terminal_wait 0


# THE `nmcli networking off/on` BOUNCE IS GONE. It was a diagnosis experiment and it is HARMFUL
# here: it drops every device's address and re-runs DHCP just before `wait for sshd`, so sshd's
# listening socket on enp0s6 loses the address it was bound to and the first probes see a guest with
# no reachable lease. The static ARP entry the daemon installs (172.30.0.2 -> TapMAC, permanent) is
# the fix for the ARP flap; the NIC does not need to be re-acquired again after sshd is already up.


step "wait for sshd"step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"
  timeout 120


step "prove the account over ssh"
  ssh "id -un; hostname"
  timeout 120


step "make sure the host keys exist"
  ssh "set -e\nprintf '%s\\n' '{{ password }}' | sudo -S -p '' mkdir -p /etc/ssh\nprintf '%s\\n' '{{ password }}' | sudo -S -p '' ssh-keygen -A 2>&1 | tail -4\necho \"--- the keys ---\"\nls -l /etc/ssh/ssh_host_*_key | head -8\necho \"--- and the one sshd needs first ---\"\nprintf '%s\\n' '{{ password }}' | sudo -S -p '' test -s /etc/ssh/ssh_host_ed25519_key\n"
  timeout 120


step "restart sshd now that the keys are on disk"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' systemctl restart sshd 2>&1 | tail -3\nsleep 2\nsystemctl is-active sshd\nss -lnt 2>/dev/null | grep ':22 ' || apt-get --version >/dev/null 2>&1 || true\n"
  timeout 180


step "enable sshd again, over ssh, where the exit status is readable"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' systemctl enable --now sshd 2>&1 | tail -3\nsystemctl is-enabled sshd\ntest \"$(systemctl is-enabled sshd)\" = \"enabled\"\n"
  timeout 180


step "prove sshd will start at boot"
  ssh "set -e\necho \"is-enabled: $(systemctl is-enabled sshd)\"\necho \"is-active:  $(systemctl is-active sshd)\"\necho \"wants:      $(ls /etc/systemd/system/multi-user.target.wants/sshd.service 2>&1)\"\ntest \"$(systemctl is-enabled sshd)\" = \"enabled\"\ntest -L /etc/systemd/system/multi-user.target.wants/sshd.service\n"
  timeout 120


step "leave the sshd diagnosis where a later boot can read it"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' sh -c '\n  {\n    echo \"=== $(date) writing the diagnosis before the reboot ===\"\n    echo \"--- is-enabled / is-active / is-failed ---\"\n    systemctl is-enabled sshd; systemctl is-active sshd; systemctl is-failed sshd\n    echo \"--- the unit that is enabled ---\"\n    systemctl cat sshd 2>&1 | head -30\n    echo \"--- the symlinks that would start it ---\"\n    ls -l /etc/systemd/system/*.wants/sshd* /etc/systemd/system/sshd* 2>&1\n    echo \"--- masked? ---\"\n    systemctl is-enabled sshd 2>&1\n    echo \"--- host keys ---\"\n    ls -l /etc/ssh/ssh_host_*_key 2>&1\n    echo \"--- the journal of this boot ---\"\n    journalctl -b -u sshd --no-pager 2>&1 | tail -20\n  } > /var/log/easyvm-sshd.txt 2>&1\n  chmod 644 /var/log/easyvm-sshd.txt\n  echo \"wrote $(wc -l < /var/log/easyvm-sshd.txt) lines to /var/log/easyvm-sshd.txt\"'\n"
  timeout 180
# `optional` IS GONE BECAUSE THE COMMAND ALREADY SAYS WHICH PART MAY FAIL: the `|| true` is on the
# `is-enabled` probe, where a socket that is not there is a fact worth printing and not a reason to
# fail. The `enable --now` itself is NOT tolerant - if the socket cannot be enabled, this stage needs
# to know, because the next boot is what proves it.


step "enable the socket as well, for a boot where the service does not start"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' sh -c '\n  systemctl enable --now sshd.socket 2>&1 | tail -3\n  systemctl is-enabled sshd.socket 2>&1 || true'\n"
  timeout 180
# `optional` IS GONE AND THE TOLERANCE IS IN THE COMMAND. A reboot that works also closes this
# connection, so the client reports a failure for a machine that is rebooting exactly as asked.
# `come back up with sshd answering` is the assertion.


step "restart the machine"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' systemctl reboot || true\n"
  timeout 60


step "come back up with sshd answering"
  repeat
    until machine_ssh
    max 90
    pause 10


step "read what this boot did"
  ssh "set -e\necho \"--- identity, over a connection that did not exist when sshd was installed ---\"\nid -un; hostname\necho \"--- is-enabled / is-active ---\"\nsystemctl is-enabled sshd; systemctl is-active sshd\necho \"--- the unit's own account of this start ---\"\njournalctl -b -u sshd --no-pager 2>&1 | tail -12\ntest \"$(systemctl is-enabled sshd)\" = \"enabled\"\ntest \"$(systemctl is-active sshd)\" = \"active\"\n"
  timeout 120


step "ask the guest to power off"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' poweroff"
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
  save "{{ out }}"

walkthrough "mint 22.3 cinnamon (ubiquity)"
resolution 1920x1080
recording_resolution 1920x1080
password admin1
var user
  default vmuser
  from args.user



step "boot the installer"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 1800
step "disable the screen saver and the lock"
  run "gsettings set org.cinnamon.desktop.session idle-delay 0; gsettings set org.cinnamon.desktop.screensaver lock-enabled false; gsettings set org.cinnamon.desktop.screensaver idle-activation-enabled false; xset s off; xset -dpms; xset s noblank; ( for i in $(seq 1 1080); do xdotool mousemove_relative -- 1 0 2>/dev/null; xdotool mousemove_relative -- -1 0 2>/dev/null; sleep 20; done ) >/dev/null 2>&1 & exit"
  settle 10
  terminal_wait 8
  type_gap 0.15


step "open the installer"
  input 114 47
    input 114 47
      double [114, 47]
  settle 25


step "open the installer - what is on screen"
  read
    name open_the_installer


step "open the installer - the screen says so"
  check
    source open_the_installer
    mode text
    name asserted
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    words [welcome]


step "welcome"
  input 1306 727
  settle 12


step "keyboard layout"
  input 1306 727
  settle 12


step "multimedia codecs"
  input 1306 727
  settle 12


step "installation type"
  input 1306 727
  settle 15


step "write the changes to disks"
  input 1269 659
  settle 20


step "time zone"
  input 1306 727
  settle 15


step "full name"
  input text "{{ user }}"
    at 965 347


step "host name"
  input text "{{ user }}"
    at 877 375

step "password"
  input text "{{ password }}"
    at 877 458


step "confirm password"
  input text "{{ password }}"
    at 877 492


step "create the account"
  input 1306 727
  settle 20


step "install"
  settle 2400

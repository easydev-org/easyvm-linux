walkthrough "mint - the ubiquity walk"
resolution 1920x1080
recording_resolution 1920x1080
var display_name "Vmuser User"
var out
  default out/distro.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user


step "the media this stage boots from is already on disk"
  needs [mint.iso]


step "create the empty disk"
  disk
    file disk.qcow2
    size 128


step "boot the installer"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=mint.iso,media=cdrom,readonly=on,if=none,id=media0"], ["-device", "ide-cd,drive=media0,bootindex=0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 1800
step "the medium's GRUB menu is up"
  read
    name grub


step "that menu names mint"
  check
    source grub
    mode text
    name is_mint
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    scale 1
    words [[start, linux, mint], [linux, mint]]

  # THE MENU TAKES THE KEY AND THEN SITS THERE, SO THE KEY IS SENT MORE THAN ONCE.
  #
  # MEASURED ON RUN 44471061649, whose recording is the SAME FRAME from 20 seconds to the end -
  # 2979 seconds of "Press enter to boot the selected OS" with the highlight still on the first
  # entry. One Return, twenty seconds, and nothing moved: unlike every later step in this file,
  # which is a click the guest has to answer, this one is a keystroke into a firmware menu that may
  # not have finished drawing when `see:` captured it.
  #
  # THREE, FIVE SECONDS APART, is what the file already does elsewhere for a screen that appears more
  # than once - and a second Return on a menu that has already gone is harmless, because the live
  # session ignores it.

step "answer the menu, which does not count down"
  input ret
  settle 5


step "answer it again, because a firmware menu can miss the first key"
  input ret
  settle 5


step "and once more, then let the kernel start"
  input ret
  settle 20


step "wait for the live desktop"
  repeat
    do
      item
        read
          name screen
    until
      source screen
      mode like
      reference reference/desktop.png
      range [0.9, 1]
      rect [1500, 150, 1900, 350]
      rect_at [1920, 1080]
      must true
    max 1080
    pause 5


step "disable the screen saver, its lock and the dpms blank"
  run "gsettings set org.cinnamon.desktop.session idle-delay 0; gsettings set org.cinnamon.desktop.screensaver lock-enabled false; gsettings set org.cinnamon.desktop.screensaver idle-activation-enabled false; xrandr --output Virtual-1 --mode 1920x1080 2>/dev/null || xrandr --output Virtual1 --mode 1920x1080 2>/dev/null || xrandr -s 1920x1080 2>/dev/null || true; xset s off; xset -dpms; xset s noblank; ( for i in $(seq 1 1080); do xdotool mousemove_relative -- 1 0 2>/dev/null; xdotool mousemove_relative -- -1 0 2>/dev/null; sleep 20; done ) >/dev/null 2>&1 & exit"
  settle 10
  terminal_wait 8
  type_gap 0.15


step "the desktop's install icon is on screen"
  read
    name desktop


step "that icon names the installer"
  check
    source desktop
    mode text
    name launcher
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    scale 1
    words [[Install]]


step "select the installer's icon"
  input 114 52
  settle 3


step "open it with the keyboard, because a double-click does not"
  input ret
  settle 25


step "the installer window is up"
  repeat
    do
      item
        settle 6
      item "read the screen"
        read
          name installer
    until
      bind up
      source installer
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      # TWO WORDS THAT ONLY THE INSTALLER DRAWS, IN THE SAME FRAME: the window's own title says
      # "Install Linux Mint" and the sidebar's first row says "Welcome". `Welcome`, `Keyboard` and
      # `Multimedia` are each one word, and MEASURED on popos a lone `language` matched the desktop's
      # own top bar - so a one-word set can pass over a bare desktop with no installer on it.
      words [[Welcome, Mint], [Keyboard, Mint], [Multimedia, Mint]]
    max 30


step "welcome"
  input 1306 727
  settle 12


step "keyboard"
  input 1306 727
  settle 12


step "multimedia codecs"
  input 1306 727
  settle 12


step "installation type"
  input 1306 727
  settle 15


step "the dialog names the filesystem it will create"
  read
    name format


step "the root partition will be ext4"
  check
    source format
    mode text
    name ext4
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    scale 1
    words [[ext4]]


step "write the changes to disks"
  input 1266 663
  settle 25


step "installation type - install now, after the modal"
  input 1307 726
  settle 30


step "where are you"
  input 1306 727
  settle 15


step "who are you - full name"
  input text "{{ display_name }}"
    at 965 347
  settle 2


step "who are you - password"
  input text "{{ password }}"
    at 877 458
  settle 2


step "who are you - confirm password"
  input text "{{ password }}"
    at 877 492
  settle 3


step "who are you"
  input 1306 727
  settle 20


step "the install finishes"
  repeat
    do
      item
        settle 15
      item "read the screen"
        read
          name finished
    until
      bind done
      source finished
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[restart]]
    max 120


# THE INSTALLER SAYS "RESTART" BEFORE IT HAS WRITTEN GRUB, AND `stop kill` DOES NOT WAIT FOR IT.
#
# MEASURED on run 45916738708 (the mint ssh stage): the published disk boots to a bare `grub>`
# prompt - GRUB's own shell, with no menuentry to run - while `grub.cfg` on the same disk is present.
# That is the signature of a bootloader installed but its configuration not yet flushed when the
# machine was killed. A `stop kill` terminates qemu at once; anything the installer had written and
# not fsynced is whatever qemu had already flushed, which is a race, not a guarantee.
#
# THE DISTROS THAT PASS HAVE THIS STEP and mint did not: anduinos, popos and ubuntu all wait twenty
# seconds between "ready to use" and the kill, with the comment "ready to use is not flushed".
step "give the installer its last few seconds, because \"restart\" is not \"flushed\""
  settle 25


step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
    save "{{ out }}"

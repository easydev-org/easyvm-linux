walkthrough "linux-ubuntu - sshd"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user



step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
step "wait for the greeter's X server to settle on the mode it was given"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name greeter
    until
      bind settled
      source greeter
      mode text
      rect [768, 641, 1062, 755]
      rect_at [1920, 1080]
      words [[password], [log], [complete, your, setup], [welcome, to, ubuntu]]
    max 24


step "greeter - the password box"
  input 936 628
  settle 3


step "greeter - log in"
  settle 3
  input text "{{ password }}"


step "greeter - submit"
  input ret
  settle 12


step "the first-login wizard is up, when this build shows one"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [768, 641, 1062, 755]
      rect_at [1920, 1080]
      words [[welcome, to, ubuntu], [complete, your, setup]]
    max 30


step "walk the first-login pages to the end"
  repeat
    do
      item
        input 1464 194
      item
        settle 4
      item "read the screen"
        read
          name page
    until
      bind done
      source page
      mode text
      without [continue, next, skip, pro, install]
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 12


step "open the terminal"
  input ctrl+alt+t
  settle 20


step "keep the screen on"
  run "xset s off; xset -dpms; xset s noblank"
  settle 3


step "sudo is unlocked for this session"
  run "printf '%s\\n' {{ password }} | sudo -S -v"
  settle 2


step "install openssh-server"
  run "sudo apt-get install -y openssh-server"
  settle 5


step "allow password authentication"
  run "sudo sed -i s/^#PasswordAuthentication.*/PasswordAuthentication\\ yes/ /etc/ssh/sshd_config && grep -i ^PasswordAuthentication /etc/ssh/sshd_config"
  settle 3


step "enable ssh at boot"
  run "sudo systemctl enable --now ssh; sudo systemctl disable --now ufw 2>/dev/null; sudo ufw disable 2>/dev/null; sudo systemctl disable --now firewalld 2>/dev/null; sudo systemctl stop firewalld 2>/dev/null; sudo iptables -P INPUT ACCEPT 2>/dev/null; sudo nft flush ruleset 2>/dev/null; echo FIREWALL_OFF"
  settle 5


step "prove ssh is active"
  run "systemctl is-active ssh"
  settle 3


step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"
  timeout 120


step "prove the account over ssh"
  ssh "id -un; hostname"
  timeout 120


step "ask the guest to power off"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' poweroff"
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
    save "{{ out }}"

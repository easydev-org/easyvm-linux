walkthrough "linux-ubuntu - sshd"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin1
# `user vmuser` IS THE HEADER KEY THE SSH CLIENT READS - `var user` IS NOT.
#
# MEASURED: `ssh_user:` is parsed from a top-level `user` line and defaults to `vmuser`; a
# `var user` only changes what gets TYPED on a console. Since this stage types nothing, the
# header value is the one that matters - but writing it makes the file say who it logs in as.
user vmuser
var user
  default vmuser
  from args.user



step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
# THERE IS NO LOGIN, NO TERMINAL AND NO install HERE, AND THAT IS THE WHOLE POINT.
#
# This stage used to type its way through a greeter, a first-login wizard and eight commands in a
# terminal, and MEASURED over ten runs of its sibling zorin the virtual keyboard drops and doubles
# characters at line boundaries - one lost `'` leaves bash at a `>` prompt that swallows every
# later command, so `wait for sshd` ran against a machine whose install had never executed.
#
# The disk this leg pulls has had an ssh server put into it BEFORE its first boot, by
# `scripts/seed-ssh.sh` (see the `seed` row in the workflow). So the only work left is to boot it
# and to check that the promise holds: a session, a kernel, an account. Not one keystroke.
#
# MEASURED on a real ubuntu disk: the seeded image reached `ssh_ready="true"` on its own, and
# `ssh "uname -a"` answered `Linux vmuser-Standard-PC-Q35-ICH9-2009 7.0.0-44-generic ... x86_64`.


step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"
  timeout 120


step "prove the account over ssh"
  ssh "id -un; hostname"
  timeout 120


step "ask the guest to power off"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' poweroff"
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
    save "{{ out }}"

walkthrough "ubuntu - the subiquity walk"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user


step "the media this stage boots from is already on disk"
  needs [ubuntu.iso]


step "create the empty disk"
  disk
    file disk.qcow2
    size 128


step "boot the installer"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=ubuntu.iso,media=cdrom,readonly=on,if=none,id=media0"], ["-device", "ide-cd,drive=media0,bootindex=0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 1800
step "wait for the live desktop"
  repeat
    do
      item
        read
          name screen
    until
      source screen
      mode like
      reference reference/desktop.png
      range [0.9, 1]
      rect [0, 0, 1920, 120]
      rect_at [1920, 1080]
      must true
    max 1080
    pause 5

step "close the right-click menu the live session leaves open"
  input esc
  settle 2


step "settle 2s"
  settle 2

  # THE INSTALLER WINDOW HAS TO BE UP BEFORE THE COMPARISON, NOT AFTER IT.
  #
  # THE ORDER WAS "compare the screen, then wait for the installer", and the two raced. MEASURED
  # ACROSS THREE RUNS: run 44349187441 captured the desktop with the installer's window as a black
  # rectangle (0.6753), run 44361392014 captured it with a right-click menu open (0.6664), and run
  # 44365861355 captured it with "Welcome to Ubuntu / Choose your language" fully drawn (0.6710).
  # Three different screens, because `desktop:` says "brightness, variance and saturation look like
  # a table" and the installer appears somewhere inside that window.
  #
  # SO THE WINDOW IS WAITED FOR FIRST, which makes the screen the comparison sees ONE screen instead
  # of three, and the reference is the frame from a run where it was already up.

step "wait for the installer window"
  # THE WINDOW MUST BE DRAWN, NOT MERELY NAMED. `mode: text` passed as soon as the OCR could read
  # "Welcome to Ubuntu" and "Choose your language" - and MEASURED on run 45120549330, from the mp4,
  # the frame at that moment still had the page half painted: the language list was there but the
  # Next button had not finished drawing, so the click that followed went into nothing and the walk
  # sat on the language page for three minutes.
  #
  # A REFERENCE COMPARISON ANSWERS "IS THIS THE FINISHED PAGE", which a word list cannot: the words
  # appear before the pixels settle. The reference is the frame this walk succeeded on, cut from that
  # same run's recording.
  repeat
    do
      item
        input 420 300
      item
        settle 5
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode like
      reference reference/langpage.png
      range [0.92, 1]
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      must true
    max 120
    pause 5


step "settle 3s"
  settle 3


step "the desktop is the one this file was written against"
  read shot


step "the screen is the one this file was written against"
  check
    source shot
    mode like
    must
    name matched
    range [0.97, 1]
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    reference reference/desktop.png


step "welcome / language"
  # THE PAGE IS PROVEN DRAWN BY THE STEP ABOVE, so this click has something to land on. It keeps a
  # `settle` for the repaint the click itself causes, which is the one wait a click still needs.
  input 1355 848
  settle 12


step "wait for the accessibility page, because a click that assumes the page before it is a click that can miss"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name page
    until
      bind there
      source page
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[accessibility]]
    max 24


step "accessibility"
  input 1355 848
  settle 12


step "wait for the keyboard layout page, because a click that assumes the page before it is a click that can miss"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name page
    until
      bind there
      source page
      mode text
      rect [885, 208, 1036, 271]
      rect_at [1920, 1080]
      words [[keyboard], [layout]]
    max 24


step "keyboard layout"
  input 1355 848
  settle 12


step "wait for the internet connection page, because a click that assumes the page before it is a click that can miss"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name page
    until
      bind there
      source page
      mode text
      rect [873, 210, 1046, 268]
      rect_at [1920, 1080]
      words [[internet], [connection]]
    max 24


step "internet connection"
  input 1355 848
  settle 12


step "read whether the installer offered to update itself, which blocks every page behind it"
  read page


step "is the update dialog up"
  check
    source page
    mode text
    name update_offered
    rect [883, 208, 1036, 271]
    rect_at [1920, 1080]
    words [update, available]


step "leave the update page by the same Next every other page uses"
  if update_offered
    then
      item "next, past the update offer"
        input 1355 848
        settle 8


step "wait for the what do you want to do with ubuntu page, because a click that assumes the page before it is a click that can miss"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name page
    until
      bind there
      source page
      mode text
      rect [944, 477, 1085, 554]
      rect_at [1920, 1080]
      words [[install], [ubuntu]]
    max 24


step "what do you want to do with ubuntu"
  input 1355 848
  settle 12


step "wait for the type of installation page, because a click that assumes the page before it is a click that can miss"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name page
    until
      bind there
      source page
      mode text
      rect [944, 209, 1045, 501]
      rect_at [1920, 1080]
      words [[interactive], [installation]]
    max 24


step "type of installation"
  input 1355 848
  settle 12


step "wait for the applications page, because a click that assumes the page before it is a click that can miss"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name page
    until
      bind there
      source page
      mode text
      rect [937, 433, 1027, 496]
      rect_at [1920, 1080]
      words [[apps]]
    max 24


step "applications"
  input 1355 848
  settle 12


step "wait for the optimise your computer page, because a click that assumes the page before it is a click that can miss"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name page
    until
      bind there
      source page
      mode text
      rect [1082, 397, 1232, 465]
      rect_at [1920, 1080]
      words [[proprietary]]
    max 24


step "optimise your computer"
  input 1355 848
  settle 12


step "wait for the disk setup page, because a click that assumes the page before it is a click that can miss"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name page
    until
      bind there
      source page
      mode text
      rect [944, 473, 1054, 545]
      rect_at [1920, 1080]
      words [[erase], [disk]]
    max 24


step "disk setup"
  input 1355 848
  settle 12


step "wait for the encryption page, because a click that assumes the page before it is a click that can miss"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name page
    until
      bind there
      source page
      mode text
      rect [852, 210, 967, 271]
      rect_at [1920, 1080]
      words [[encryption]]
    max 24


step "encryption"
  input 1355 848
  settle 12


step "wait for the account page before typing into it"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name page
    until
      bind there
      source page
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[create, account]]
    max 24


step "create your account - full name - click the field"
  input 1139 393


step "create your account - full name - select what is there"
  input ctrl+a
  settle 1


step "create your account - full name - delete the selection"
  input backspace
  settle 1


step "create your account - full name - type the value"
  input text "{{ user }}"
  settle 2

step "create your account - username - click the field"
  input 1139 501


step "create your account - username - select what is there"
  input ctrl+a
  settle 1


step "create your account - username - delete the selection"
  input backspace
  settle 1


step "create your account - username - type the value"
  input text "{{ user }}"
  settle 2

step "create your account - password - click the field"
  input 1050 563


step "create your account - password - select what is there"
  input ctrl+a
  settle 1


step "create your account - password - delete the selection"
  input backspace
  settle 1


step "create your account - password - type the value"
  input text "{{ password }}"
  settle 2

step "create your account - confirm password - click the field"
  input 1139 616


step "create your account - confirm password - select what is there"
  input ctrl+a
  settle 1


step "create your account - confirm password - delete the selection"
  input backspace
  settle 1


step "create your account - confirm password - type the value"
  input text "{{ password }}"
  settle 3

step "clear 'require my password to log in'"
  input 923 670
  settle 3


step "create your account"
  input 1355 848
  settle 12


step "wait for the time zone page"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name page
    until
      bind there
      source page
      mode text
      rect [944, 210, 1050, 268]
      rect_at [1920, 1080]
      words [[timezone]]
    max 24


step "time zone - new york on the map"
  input 762 483
  settle 4


step "time zone"
  input 1355 848
  settle 14


step "ready to install - the green install button"
  input 1355 848
  settle 30


step "the installer finishes"
  repeat
    do
      item
        input 420 300
        settle 20
      item
        settle 2
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [690, 630, 1270, 730]
      rect_at [1920, 1080]
      words [[installed, and, ready, to, use], [restart, to, complete, the, installation], [restart, now]]
    max 270


step "give the installer its last few seconds, because \"ready to use\" is not \"flushed\""
  settle 20


step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
    save "{{ out }}"

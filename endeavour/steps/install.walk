walkthrough "endeavouros - install to ext4, then the power button"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/endeavouros.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user


step "the media this stage boots from is already on disk"
  needs [endeavour.iso]


step "create the empty disk"
  disk
    file disk.qcow2
    size 128


step "boot the installer"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=endeavour.iso,media=cdrom,readonly=on,if=none,id=media0"], ["-device", "ide-cd,drive=media0,bootindex=0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 1800
step "wait for the live desktop"
  repeat
    do
      item
        read
          name screen
    until
      source screen
      mode like
      reference reference/desktop.png
      range [0.9, 1]
      rect [0, 0, 1920, 120]
      rect_at [1920, 1080]
      must true
    max 1080
    pause 5


step "let the desktop settle"
  settle 15


# ONE CLICK, ON THE WELCOME WINDOW'S `Start the Installer` ROW.
#
# THIS WAS BRIEFLY A WAIT-THEN-PRESS AND IT IS BACK TO A PRESS, because the wait was WORKING AROUND A
# FAULT I HAD INTRODUCED MYSELF. The history, so nobody re-adds it:
#
#	tried   a browser-dismiss guard with `alt+f4`
#	result  `alt+f4` closes the FOCUSED window, and the Welcome window matches whenever the OCR reads
#	        `Firefox` or `Privacy` anywhere on screen - both words are drawn in that window's own text.
#	        It closed the window the walk was waiting for, and the leg ended on bare wallpaper
#	        (measured: 45418398321).
#	tried   a `when: [Start, Installer]` gate on the press
#	result  skipped the press whenever the window was late, so the failure moved from "a window is in
#	        front" to "the installer never started" (measured: 45418398321's predecessor).
#
# EVERY ONE OF THOSE WAS A REACTION TO A WINDOW OPENED BY A PREVIOUS MISPLACED CLICK, NOT A CAUSE. The
# flow the medium actually has is: the live session draws its Welcome window, `Start the Installer` is
# the first row under INSTALL at y=427, and pressing it once starts Calamares. So the walk waits 15
# seconds for that window (the `settle` above, which is what the original had) and presses.
#
# MEASURED as working, on a leg that carried the wait this replaces: run 45421053960 (commit 82a759e),
# whose log shows the press followed by `calamares is up` and whose publish step pushed a 4264 MiB
# disk. The press is the same press; what is gone is the OCR wait in front of it.
step "start the installer"
  input 748 431
  settle 25


step "choose the offline method"
  input 1084 591
  settle 30


step "calamares is up"
  read
    name cal


step "the welcome page is in English or needs changing"
  check
    source cal
    mode text
    name seen
    rect [570, 225, 1340, 745]
    rect_at [1920, 1080]
    scale 2
    words [[welcome], [歡迎]]


step "open the language list"
  input 980 661
  settle 4


step "jump to the English group"
  input e
  settle 2


step "step up to British English"
  input up
  settle 1


step "step up to American English"
  input up
  settle 1


step "choose it"
  input ret
  settle 6


step "the installer speaks English"
  read
    name english


step "the page is in English"
  check
    source english
    mode text
    name ok
    rect [570, 225, 1340, 745]
    rect_at [1920, 1080]
    scale 2
    words [[welcome]]


step "next from welcome"
  input 1410 878
  settle 9


step "next from location"
  input 1410 878
  settle 9


step "next from keyboard"
  input 1410 878
  settle 9


step "the bootloader page"
  read
    name boot


step "next from bootloader"
  input 1410 878
  settle 9


step "the partitions page"
  read
    name parts


step "select erase disk"
  input 679 252
  settle 8


step "the partitions page with erase selected"
  read
    name erase


step "the default filesystem is ext4"
  check
    source erase
    mode text
    name ext4
    rect [570, 225, 1340, 745]
    rect_at [1920, 1080]
    scale 2
    words [[ext4]]


step "next from partitions"
  input 1410 878
  settle 10


step "the users page settles before anything is typed into it"
  repeat
    do
      item
        settle 8
      item "read the screen"
        read
          name at_users
    until
      bind here
      source at_users
      mode text
      rect [570, 225, 1340, 745]
      rect_at [1920, 1080]
      scale 2
      words [[Reuse]]
    max 24


step "the users page"
  read
    name users


step "the full name"
  input text "{{ user }}"
    at 850 299
  settle 2


step "the login name - click the field"
  input 850 354


step "the login name - select what is there"
  input ctrl+a
  settle 1


step "the login name - delete the selection"
  input backspace
  settle 1


step "the login name - type the value"
  input text "{{ user }}"
  settle 2

step "the computer name - click the field"
  input 850 434


step "the computer name - select what is there"
  input ctrl+a
  settle 1


step "the computer name - delete the selection"
  input backspace
  settle 1


step "the computer name - type the value"
  input text endeavouros
  settle 2

step "the password"
  input text "{{ password }}"
    at 700 515
  settle 2

  # THE ROOT PASSWORD IS TYPED INTO ITS FIELDS RATHER THAN TICKED BY A CHECKBOX.
  #
  # THE CHECKBOX WAS TRIED TWICE AND MEASURED TO FAIL BOTH TIMES. The frame from run 44447463692
  # shows "Reuse user password as root password" still UNCHECKED with the Root password and Repeat
  # root password fields EMPTY, after six clicks at the box's own centre (584, 648) and six at the
  # label (700, 648). Calamares' Qt checkbox toggles on the indicator and ignores the label, and the
  # indicator is 14 px wide - one repaint from being missed.
  #
  # A FORM FIELD IS 300 px WIDE AND CANNOT BE MISSED, and it is what the checkbox would have filled
  # anyway: the label says "reuse the user password for root", so the value to type is the same one.
  #
  # `clear: true` first, because a half-filled field from a click that landed in it is worse than an
  # empty one - Calamares shows the mismatch and keeps Next disabled either way.

step "the password again - click the field"
  input 900 515


step "the password again - select what is there"
  input ctrl+a
  settle 1


step "the password again - delete the selection"
  input backspace
  settle 1


step "the password again - type the value"
  input text "{{ password }}"
  settle 2

step "the root password - first field - click the field"
  input 700 703


step "the root password - first field - select what is there"
  input ctrl+a
  settle 1


step "the root password - first field - delete the selection"
  input backspace
  settle 1


step "the root password - first field - type the value"
  input text "{{ password }}"
  settle 2

step "the root password - second field - click the field"
  input 993 703


step "the root password - second field - select what is there"
  input ctrl+a
  settle 1


step "the root password - second field - delete the selection"
  input backspace
  settle 1


step "the root password - second field - type the value"
  input text "{{ password }}"
  settle 2

step "log in automatically"
  input 587 755
  settle 3


step "the users page is filled in"
  read
    name filled


step "the password was accepted"
  check
    source filled
    mode text
    name ok
    rect [570, 225, 1340, 745]
    rect_at [1920, 1080]
    scale 2
    without [match]
    words [ok]


step "next from users"
  input 1410 878
  settle 10


step "the summary page arrives before install is clicked"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name settle
    until
      bind here
      source settle
      mode text
      rect [570, 225, 1340, 745]
      rect_at [1920, 1080]
      scale 2
      words [[summary], [install]]
    max 30


step "the summary page"
  read
    name summary


step "the summary names ext4"
  check
    source summary
    mode text
    name ext4
    rect [570, 225, 1340, 745]
    rect_at [1920, 1080]
    scale 2
    words [[ext4]]


step "start the install"
  input 1412 868
  settle 10


step "the confirmation dialog"
  read
    name confirm


step "install now"
  input 1064 540
  settle 25



step "the install is done"
  repeat
    do
      item
        settle 15
      item "read the screen"
        read
          name done
    until
      bind finished
      source done
      mode text
      rect [570, 225, 1340, 745]
      rect_at [1920, 1080]
      scale 2
      words [[installed]]
    max 80


# THE INSTALLER SAYS IT IS DONE BEFORE ITS BOOTLOADER IS FLUSHED.
#
# MEASURED on mint's published disk (run 45916738708): it boots to a bare `grub>` prompt although
# grub.cfg exists - a bootloader installed and its configuration not yet fsynced when `stop kill`
# terminated qemu. anduinos, popos and ubuntu pass and all of them settle twenty seconds between
# "ready to use" and the kill; this is the same wait.
step "give the installer its last few seconds, because \"done\" is not \"flushed\""
  settle 25


step "stop the machine"
  stop kill
  timeout 600


step "publish the disk"
    save "{{ out }}"

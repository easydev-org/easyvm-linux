walkthrough "linux-endeavour - sshd"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user



step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
step "the disk's boot menu, when it has one"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name grubmenu
    until
      bind at_menu
      source grubmenu
      mode text
      rect [400, 300, 1520, 780]
      rect_at [1920, 1080]
      scale 1
      words [[endeavour], [reboot, into, firmware]]
    max 12
  optional

  # THE MENU COUNTS ITSELF DOWN ("Boot in 3s"), SO RETURN MAY ARRIVE AFTER IT ALREADY BOOTED.
  #
  # MEASURED ON RUN 44557723577's successor: `at_menu = true (read "reboot into firmware")` and then
  # `key ret`, and the next frames are BLANK - the kernel's own boot takes longer than the twenty
  # seconds this step waited, so the greeter wait that follows saw an empty screen and its Escapes
  # went into the bootsplash.
  #
  # Sixty seconds, then the greeter wait gets a screen instead of a splash.

step "boot the highlighted entry, which is the installed system"
  input ret
  settle 60

  # THE GREETER IS ASKED FOR, AND THE DESKTOP IS WAITED FOR, AND NEITHER WAS HERE.
  #
  # MEASURED ON RUN 44557514172, whose ssh recording at 90 s is SDDM's login screen with a password
  # field holding SIXTEEN dots - this walk types five characters once - and no session. Then every
  # `run:` of the stage produced no output at all, because there was no terminal to type into: the
  # screen never left the greeter.
  #
  # TWO THINGS WERE MISSING, BOTH OF WHICH THE OTHER KDE STAGE (cachyos) HAS:
  #
  #   1. A WAIT FOR THE GREETER. `click ... at 936 628` was the first thing after boot, so it could
  #      land before SDDM had drawn - and a click into nothing leaves the password typed into
  #      whatever has focus.
  #   2. A WAIT FOR THE DESKTOP. `ctrl+alt+t` came 12 s after Return, which is not long enough for
  #      Plasma to start, and a chord pressed during that gap goes to the greeter.
  #
  # The band and scale are the ones cachyos reads 'Password vmuser' from on the same SDDM.
  # ESCAPE IS PART OF THE WAIT, NOT A STEP AFTER IT.
  #
  # MEASURED ON RUN 44556277158, whose ssh recording's last frame is SDDM's CLOCK-ONLY SCREEN - the
  # wall paper, '11:09 AM', 'Thursday, November 19, 2026', 'Desktop Session: Plasma (Wayland)' - and
  # no login box at all. The stage read '— t a ely —' from the password band sixty times.
  #
  # THAT SCREEN IS SDDM'S SCREEN SAVER, and Escape is what dismisses it - which is what cachyos's
  # file does first, and what this one had in a different order: a wait that cannot succeed until
  # the screen is woken, followed by the wake. A wait whose action does nothing is a wait that
  # expires.
  #
  # The action is `key: esc` now, so the loop wakes the screen and looks again, up to sixty times.
  # THE GREETER IS WOKEN FIRST, THEN WAITED FOR - AND THE ORDER IS THE FIX.
  #
  # MEASURED ON RUN 44557723577's successor: at 200 s the screen is SDDM's SCREEN SAVER - the wall
  # paper, '12:19 PM', 'Desktop Session: Plasma (Wayland)', no login box - and from 200 s to the end
  # it is BLACK. A wait that begins on a blanked screen cannot succeed, and this one had no wake in
  # it at all (the Escape was removed when mx needed the opposite).
  #
  # Escape ONCE before the wait, and once inside it, covers both the saver and the full blank:
  #   - the pre-Escape wakes a screen saver;
  #   - the in-loop Escape repeats it, since SDDM re-blanks on its own timer.
  # THE GREETER IS LOGGED IN WHERE IT STANDS. THE VIRTUAL CONSOLE DOES NOT SWITCH ON THIS GUEST.
  #
  # MEASURED ON RUN 44585827654: after 'ctrl+alt+f2' the console-tail read ZERO WORDS - a black
  # screen, not a getty. The chord does not reach a virtual console here, and manjaro's run showed
  # the same thing with SDDM's 'Virtual Keyboard' still on screen.
  #
  # The greeter this file already waited for IS a usable login - 'vmuser' with a password field -
  # so the click, the password and Return are what this stage does, and the desktop gate confirms
  # the session started before anything is typed.

step "greeter - the password box"
  input 936 628
  settle 3


step "greeter - log in"
  settle 3
  input text "{{ password }}"


step "greeter - submit"
  input ret
  settle 20


# THE REFERENCE IMAGE WAS A LIVE-ISO FRAME, NOT THIS DESKTOP.
#
# MEASURED on run 45916747458: the step scored 0.4771 against reference/desktop.png for its whole
# budget. That file is the INSTALLER's own screenshot - "Welcome v26.7.2-1 [ISO: 2026.08.15]",
# "Installing EndeavourOS to disk", "Please wait...", the clock reading 2026-08-15 - captured from the
# live medium. The ssh stage boots the INSTALLED system, whose top bar has none of it. Comparing them
# could never reach 0.9.
#
# SO THE DESKTOP IS RECOGNISED BY A WORD, the way kubuntu's is: this is Xfce, whose panel carries the
# application menu labelled `Whisker` on the installed system, and the live installer window the
# reference shows is gone. Waiting for the word is the check that describes the state this file
# actually needs - a logged-in desktop, not a particular picture of one.
# THE DESKTOP IS RECOGNISED BY THE WINDOW A LOGGED-IN SESSION DRAWS, NOT BY ITS PANEL.
#
# MEASURED on run 45937524104's final frame: the desktop IS up - the Xfce panel is along the bottom,
# the "DEAVOUROS TAN" wallpaper fills it - and "Welcome v26.7.2-1" is open in the middle with the
# "After Install" tab. My first word check looked for `whisker`/`applications`/`terminal` in a 24 px
# strip at the bottom and read "2m Pr OD": the panel's labels are too small and too dim for the
# reader, while the window's title and tabs are large. Waiting for the window is the honest signal -
# it is a program the INSTALL put there, so its presence is what "logged in, installed system" looks
# like - and it is the thing that then has to be closed before the terminal can take the keyboard.
step "the desktop is up after the login"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name screen
    until
      bind up
      source screen
      mode text
      rect [550, 200, 1400, 800]
      rect_at [1920, 1080]
      words [[after, install], [welcome], [general, info]]
    max 120


# ONE alt+f4 CLOSES THE WINDOW; A SECOND LOCKS THE SESSION.
#
# MEASURED on run 45939403696's recording at 550 s: the screen is the LOCK SCREEN - the clock at
# 11:32 PM over the "ENDEAVOUROS TITAN" wallpaper and NO window at all - after this pair of alt+f4
# presses. The first closed "Welcome v26.7.2-1"; the second landed on an empty desktop and locked it,
# so every `run:` below typed into a lock screen. This is the same failure kubuntu had, and the same
# fix: ONE press, then let the file's next steps work on a desktop that is still logged in.
#
# (endeavour's Xfce screensaver locks on the same idle/blank path the file's earlier
# "disable the screen saver" step was written for; the lock is what a second window-close reaches.)
step "close the welcome window, so the keyboard belongs to the desktop"
  input alt+f4
  settle 6


step "open the terminal"
  input ctrl+alt+t
  settle 20

  # NO PROBE COMMAND FIRST. MEASURED ON RUN 44586147027, whose terminal reads
  #
  #	$ echo TERMINAL_READYXSET S OFF; XSET S NOBLANK; ECHO ADMIN | sudo S pacman ...
  #	[sudo] password for vmuser:
  #
  # - the probe's Return was lost, so the NEXT step's command was appended to it, and every
  # character of that command arrived in capitals (the shift state again). The probe cost nothing to
  # remove and removes the seam: the first thing typed after the chord is the command that matters.

step "keep the screen on and unlock sudo, before anything needs it"
  # THIS GUEST HAS NO `xset`: its blanking is Xfce's own DPMS. MEASURED on run
  # 45941267442's final second - a BLACK FRAME, the display switched off during the wait.
  # `xfconf-query` turns dpms and blanking off; `xset` stays as a best-effort first choice.
  run "printf '%s\\n' {{ password }} | sudo -S -v; echo SUDO_UNLOCKED"
  settle 6
  terminal_wait 0

  # NO `terminal_wait:` HERE, AND THAT IS THE FIX RATHER THAN AN OMISSION.
  #
  # `terminal_wait:` OPENS A TERMINAL (ctrl+alt+t) AND THEN TYPES. The step above has already
  # opened one, so a second ctrl+alt+t starts a NEW terminal window and the keys that follow go to
  # it - while the command already typed into the first one is never submitted.
  #
  # MEASURED ON RUN 44545555943's kubuntu ssh recording, whose terminal shows exactly that:
  #
  #	vmuser@kubuntu:~$ xset s off; xset -dpms; xset s noblank; echo SCREEN_KEPT_ONECHO ADMIN | sudo ...
  #	server does not have extension for -dpms option
  #	[sudo: authenticate] Password:
  #
  # `SCREEN_KEPT_ON` runs straight into `ECHO ADMIN` with no line break: the Return after the first
  # command went to the OTHER window. And the `xset -dpms` failure - "server does not have extension
  # for -dpms option" - is harmless; the screen is still kept awake by `s off` and `s noblank`.

step "install openssh"
  # `pacman -Sy openssh` TRIES TO UPGRADE openssl AND BREAKS pacman ITSELF.
  #
  # MEASURED on run 45941450719's recording at 500 s, on the terminal:
  #
  #	$ sudo pacman -Sy --noconfirm --needed openssh
  #	:: installing openssl (4.1.0-1) breaks dependency 'libcrypto.so=3-64' required by ostree
  #	:: installing openssl (4.1.0-1) breaks dependency 'libcrypto.so=3-64' required by pacman
  #	:: installing openssl (4.1.0-1) breaks dependency 'libcrypto.so=3-64' required by sudo
  #
  # So NOTHING was installed - no sshd, hence "sshd does not accept a connection". This is the classic
  # partial-upgrade trap: `-Sy` refreshes the index and then resolves against the newest packages, and
  # this disk's openssl is older than what the mirror carries. `--ignore openssl*` installs openssh
  # against the packages the disk already has.
  run "xset s off 2>/dev/null; xset s noblank 2>/dev/null; sudo -n pacman -S --noconfirm --needed --ignore openssl --ignore openssl-libs openssh 2>&1 | tail -5"
  settle 45
  terminal_wait 0


step "allow password authentication"
  run "sudo -n sh -c 'mkdir -p /etc/ssh/sshd_config.d; printf \"PasswordAuthentication yes\\n\" > /etc/ssh/sshd_config.d/99-vm.conf; sed -i \"s/^#\\?\\s*PasswordAuthentication.*/PasswordAuthentication yes/\" /etc/ssh/sshd_config; grep -q \"^PasswordAuthentication yes\" /etc/ssh/sshd_config || printf \"PasswordAuthentication yes\\n\" >> /etc/ssh/sshd_config' 2>&1 | tail -3"
  settle 3
  terminal_wait 0


  # EVERY `sudo` IN A PIPE NEEDS ITS OWN PASSWORD - `echo pw | sudo -S a; sudo b` GIVES b NONE.
  #
  # MEASURED on run 45945432461's recording at 400 s, on the terminal:
  #
  #	$ echo admin1 | sudo -S -p '' mkdir -p /etc/ssh; echo admin1 | sudo -S -p '' ssh-keygen -A ... ; test -s /etc/ssh/ssh_host_ed25519_key && echo HOST_KEYS_OK || echo HOST_KEYS_MISSING
  #	HOST_KEYS_MISSING
  #	$ echo admin1 | sudo -S systemctl start sshd.socket ... ; sudo sysctl ... ; for i in ...; do echo 2 | sudo tee ...
  #	$ echo admin1 | sudo -S systemctl restart sshd
  #	$ systemctl is-active sshd          <- empty: sshd is not active
  #
  # `sudo -S` reads the password from stdin ONCE per invocation, and `sudo` also CACHES a timestamp -
  # but the FIRST `sudo -S -v` that would seed that cache is in a step whose keystrokes went to a
  # window this stage had lost. So `mkdir` was authenticated and `ssh-keygen` (a SECOND sudo in the
  # same line, with no pipe feeding it) was not: no host keys, no sshd, "no route to host".
  #
  # The fix is `sudo -S -v` FIRST, on its own line, which seeds the timestamp for every sudo that
  # follows in the same terminal - then the rest needs no password at all.
step "make the host keys, in a run: - ssh: cannot run before sshd exists"
  # sshd REFUSES TO START WITHOUT HOST KEYS, AND THIS FILE NEVER MADE ANY IN A `run:`.
  #
  # MEASURED: everything the stage could report was "no route to host", and the probe line is
  # `dial tcp 172.30.0.1:2222: connect: no route to host` - the guest has no listener. manjaro's
  # `ssh-keygen -A` is inside an `ssh:` step (line ~257), which runs OVER ssh - so it can only work
  # once sshd is already up, which is exactly what it is supposed to cause. cachyos, which passes,
  # does the keygen in a `run:` before anything waits. This is that step.
  run "sudo -n sh -c 'mkdir -p /etc/ssh; ssh-keygen -A; test -s /etc/ssh/ssh_host_ed25519_key && echo HOST_KEYS_OK || echo HOST_KEYS_MISSING' 2>&1 | tail -6"
  settle 10


step "enable sshd at boot"
  run "sudo -n sh -c 'systemctl start sshd.socket 2>/dev/null; systemctl enable sshd; ufw disable 2>/dev/null; systemctl disable --now firewalld 2>/dev/null; sysctl -w net.ipv4.conf.all.rp_filter=2 >/dev/null 2>&1; sysctl -w net.ipv4.conf.default.rp_filter=2 >/dev/null 2>&1; systemctl is-active sshd; ss -lnt | grep :22 || echo NO_LISTENER; echo FIREWALL_OFF' 2>&1 | tail -8"$i" >/dev/null 2>&1; done; echo FIREWALL_OFF"
  settle 8
  terminal_wait 0


step "start sshd"
  run "sudo -n systemctl restart sshd 2>&1 | tail -3"
  settle 10
  terminal_wait 0


step "prove sshd is active"
  run "systemctl is-active sshd"
  settle 5
  terminal_wait 0


step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"
  timeout 120


step "prove the account over ssh"
  ssh "id -un; hostname"
  timeout 120


step "ask the guest to power off"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' poweroff"
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
    save "{{ out }}"
